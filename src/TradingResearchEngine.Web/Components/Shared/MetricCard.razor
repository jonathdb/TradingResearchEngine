<MudPaper Class="@(IsPrimary ? "pa-4" : "pa-3")" Elevation="1" Style="text-align: center;">
    <MudText Typo="Typo.caption" Style="opacity: 0.6;">@Label</MudText>
    <MudText Typo="@(IsPrimary ? Typo.h5 : Typo.h6)">@Value</MudText>
</MudPaper>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public bool IsPrimary { get; set; } = false;
}
