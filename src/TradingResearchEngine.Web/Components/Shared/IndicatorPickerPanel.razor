@using TradingResearchEngine.Application.Indicators

<MudPaper Class="pa-4" Elevation="1">
    <MudText Typo="Typo.subtitle1" Class="mb-3">Indicator Library</MudText>

    <MudStack Row="true" Spacing="2" Class="mb-3">
        <MudTextField @bind-Value="_search" Placeholder="Search indicators..."
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined" Immediate="true" Style="flex:1" Margin="Margin.Dense" />
        <MudSelect T="string" @bind-Value="_categoryFilter" Label="Category" Variant="Variant.Outlined"
                   Style="min-width:150px" Dense="true" Clearable="true">
            @foreach (var cat in _categories)
            {
                <MudSelectItem Value="@cat">@cat</MudSelectItem>
            }
        </MudSelect>
    </MudStack>

    @if (FilteredEntries.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="text-muted">No indicators match your search.</MudText>
    }
    else
    {
        <MudList T="SkenderCatalogEntry" Dense="true">
            @foreach (var entry in FilteredEntries)
            {
                <MudListItem T="SkenderCatalogEntry">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudStack Spacing="0" Style="flex:1">
                            <MudText Typo="Typo.body2" Style="font-weight:600">@entry.DisplayName</MudText>
                            <MudText Typo="Typo.caption" Class="text-muted">@entry.Description</MudText>
                            <MudStack Row="true" Spacing="1" Class="mt-1">
                                <MudChip T="string" Size="MudBlazor.Size.Small" Variant="Variant.Outlined">@entry.Category</MudChip>
                                @foreach (var output in entry.AllOutputFields.Take(3))
                                {
                                    <MudChip T="string" Size="MudBlazor.Size.Small" Color="Color.Info" Variant="Variant.Text">@output</MudChip>
                                }
                            </MudStack>
                        </MudStack>
                        <MudButton Size="MudBlazor.Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                   OnClick="@(() => OnAdd.InvokeAsync(entry))">
                            Add
                        </MudButton>
                    </MudStack>
                </MudListItem>
            }
        </MudList>
    }
</MudPaper>

@code {
    /// <summary>Callback when an indicator is selected for addition to the strategy.</summary>
    [Parameter] public EventCallback<SkenderCatalogEntry> OnAdd { get; set; }

    private string _search = "";
    private string? _categoryFilter;
    private List<string> _categories = new();

    protected override void OnInitialized()
    {
        _categories = SkenderIndicatorCatalog.FunctionalEntries
            .Select(e => e.Category)
            .Distinct()
            .OrderBy(c => c)
            .ToList();
    }

    private List<SkenderCatalogEntry> FilteredEntries => SkenderIndicatorCatalog.FunctionalEntries
        .Where(e => string.IsNullOrWhiteSpace(_search) ||
                    e.DisplayName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    e.Key.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    e.Description.Contains(_search, StringComparison.OrdinalIgnoreCase))
        .Where(e => _categoryFilter is null || e.Category == _categoryFilter)
        .ToList();
}
