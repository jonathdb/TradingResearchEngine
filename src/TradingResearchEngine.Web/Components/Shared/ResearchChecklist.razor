@using TradingResearchEngine.Application.Research
@using TradingResearchEngine.Application.Helpers

<MudPaper Outlined="true" Class="pa-4">
    <MudText Typo="Typo.subtitle2" Class="text-muted mb-3">RESEARCH PROGRESS</MudText>

    <MudProgressLinear Value="@ProgressPercent"
                       Color="@(ProgressPercent >= 100 ? Color.Success : Color.Primary)"
                       Rounded="true"
                       Size="MudBlazor.Size.Medium"
                       Class="mb-2" />
    <MudText Typo="Typo.caption" Class="text-muted mb-3">@ProgressText</MudText>

    <MudStack Spacing="1">
        @foreach (var item in ItemDetails)
        {
            @CheckItemWithNavigation(item)
        }
    </MudStack>

    <MudDivider Class="my-3" />

    @* Confidence explanation (not just numeric score) *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudText Typo="Typo.body2" Class="text-muted">Confidence Level:</MudText>
        <MudChip T="string" Size="MudBlazor.Size.Small"
                 Color="@ConfidenceColor"
                 aria-label="@($"Confidence level: {Checklist.ConfidenceLevel}")">
            @Checklist.ConfidenceLevel (@Checklist.PassedCount of @Checklist.TotalChecks)
        </MudChip>
    </MudStack>

    <MudText Typo="Typo.caption" Class="text-muted mt-2">
        @ResearchChecklistService.GetConfidenceExplanation(Checklist)
    </MudText>

    @if (IncompleteItems.Count > 0 && HasCriticalIncomplete)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3"
                  aria-label="Critical research steps incomplete">
            <MudText Typo="Typo.caption">
                <strong>Gating criteria not met:</strong> Critical research steps must be completed before final validation.
            </MudText>
        </MudAlert>
    }
</MudPaper>

<style>
    @@keyframes pulse-icon {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.4; }
    }
    .research-step-pulse {
        animation: pulse-icon 1.5s ease-in-out infinite;
    }
    .research-step-critical {
        border-left: 3px solid var(--mud-palette-warning);
        padding-left: 8px;
        margin-left: -11px;
    }
    .research-step-incomplete {
        background-color: rgba(var(--mud-palette-warning-rgb), 0.05);
        border-radius: 4px;
        padding: 4px 8px;
    }
</style>

@code {
    [Parameter, EditorRequired]
    public TradingResearchEngine.Application.Research.ResearchChecklist Checklist { get; set; } = default!;

    private double ProgressPercent => ChartComputationHelpers.ComputeProgressPercent(GetStepStatuses());

    private string ProgressText => ChartComputationHelpers.ComputeProgressText(GetStepStatuses());

    private Color ConfidenceColor => Checklist.ConfidenceLevel switch
    {
        "HIGH" => Color.Success,
        "MEDIUM" => Color.Warning,
        _ => Color.Error
    };

    private IReadOnlyList<ChecklistItemDetail> ItemDetails =>
        ResearchChecklistService.GetItemDetails(Checklist);

    private IReadOnlyList<ChecklistItemDetail> IncompleteItems =>
        ResearchChecklistService.GetIncompleteItems(Checklist);

    private bool HasCriticalIncomplete =>
        !ResearchChecklistService.AreCriticalItemsComplete(Checklist);

    private IReadOnlyList<ResearchStepStatus> GetStepStatuses()
    {
        var booleans = new[]
        {
            Checklist.InitialBacktest,
            Checklist.MonteCarloRobustness,
            Checklist.WalkForwardValidation,
            Checklist.RegimeSensitivity,
            Checklist.RealismImpact,
            Checklist.ParameterSurface,
            Checklist.FinalHeldOutTest,
            Checklist.PropFirmEvaluation,
            Checklist.CpcvDone
        };

        return booleans.Select((b, i) => MapToStatus(b, i, booleans)).ToList();
    }

    /// <summary>
    /// Maps a boolean step value to a ResearchStepStatus.
    /// true → Completed, false → InProgress if it's the first uncompleted step after all completed ones, otherwise NotStarted.
    /// </summary>
    private static ResearchStepStatus MapToStatus(bool value, int index, bool[] allSteps)
    {
        if (value)
            return ResearchStepStatus.Completed;

        // The first uncompleted step (after all preceding completed steps) is InProgress
        bool allPreviousCompleted = true;
        for (int i = 0; i < index; i++)
        {
            if (!allSteps[i])
            {
                allPreviousCompleted = false;
                break;
            }
        }

        return allPreviousCompleted ? ResearchStepStatus.InProgress : ResearchStepStatus.NotStarted;
    }

    private RenderFragment CheckItemWithNavigation(ChecklistItemDetail item) => __builder =>
    {
        var status = item.IsComplete ? ResearchStepStatus.Completed : ResearchStepStatus.NotStarted;
        // Determine if this is the "in progress" item (first incomplete after all completed)
        var booleans = new[]
        {
            Checklist.InitialBacktest, Checklist.MonteCarloRobustness, Checklist.WalkForwardValidation,
            Checklist.RegimeSensitivity, Checklist.RealismImpact, Checklist.ParameterSurface,
            Checklist.FinalHeldOutTest, Checklist.PropFirmEvaluation, Checklist.CpcvDone
        };
        var keys = new[]
        {
            "InitialBacktest", "MonteCarloRobustness", "WalkForwardValidation",
            "RegimeSensitivity", "RealismImpact", "ParameterSurface",
            "FinalHeldOutTest", "PropFirmEvaluation", "CpcvDone"
        };
        int index = Array.IndexOf(keys, item.Key);
        if (index >= 0)
            status = MapToStatus(item.IsComplete, index, booleans);

        var icon = status switch
        {
            ResearchStepStatus.Completed => Icons.Material.Filled.CheckCircle,
            ResearchStepStatus.InProgress => Icons.Material.Filled.Pending,
            _ => Icons.Material.Outlined.Circle
        };
        var iconColor = status switch
        {
            ResearchStepStatus.Completed => Color.Success,
            ResearchStepStatus.InProgress => Color.Warning,
            _ => Color.Default
        };
        var iconClass = status == ResearchStepStatus.InProgress ? "research-step-pulse" : "";
        var textOpacity = status == ResearchStepStatus.NotStarted ? "opacity: 0.5;" : "";
        var containerClass = !item.IsComplete && item.IsCritical ? "research-step-critical research-step-incomplete" : 
                             !item.IsComplete ? "research-step-incomplete" : "";

        <div class="@containerClass">
            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                <MudIcon Icon="@icon" Color="@iconColor" Size="MudBlazor.Size.Small" Class="@iconClass" />
                @if (!item.IsComplete)
                {
                    <MudTooltip Text="@item.ConfidenceExplanation" Placement="Placement.Right">
                        <MudLink Href="@item.NavigationPath" Typo="Typo.body2" Style="@textOpacity"
                                 aria-label="@($"Navigate to {item.Label}")">
                            @item.Label
                        </MudLink>
                    </MudTooltip>
                    @if (item.IsCritical)
                    {
                        <MudChip T="string" Size="MudBlazor.Size.Small" Color="Color.Warning" Variant="Variant.Outlined"
                                 aria-label="Critical gating item">
                            Critical
                        </MudChip>
                    }
                }
                else
                {
                    <MudTooltip Text="@GetStepDescription(item.Key)" Placement="Placement.Right">
                        <MudText Typo="Typo.body2" Style="@textOpacity">@item.Label</MudText>
                    </MudTooltip>
                }
            </MudStack>
        </div>;
    };

    private string GetStepDescription(string stepKey)
    {
        return ChartComputationHelpers.StepDescriptions.TryGetValue(stepKey, out var desc) ? desc : string.Empty;
    }
}
