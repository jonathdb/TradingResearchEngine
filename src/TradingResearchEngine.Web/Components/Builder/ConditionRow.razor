@using TradingResearchEngine.Application.Strategies.Composite.Conditions

@* A single comparison or cross-detection row in the condition builder. *@

<MudPaper Class="pa-2 mb-1" Outlined="true" Elevation="0">
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (Node is ComparisonNode comparison)
        {
            <MudText Typo="Typo.body2" Class="text-muted">@FormatValueNode(comparison.Left)</MudText>
            <MudChip T="string" Size="MudBlazor.Size.Small" Color="Color.Default">@FormatOperator(comparison.Operator)</MudChip>
            <MudText Typo="Typo.body2" Class="text-muted">@FormatValueNode(comparison.Right)</MudText>
        }
        else if (Node is CrossNode cross)
        {
            <MudText Typo="Typo.body2" Class="text-muted">@FormatValueNode(cross.Left)</MudText>
            <MudChip T="string" Size="MudBlazor.Size.Small" Color="Color.Secondary">
                @(cross.Direction == CrossDirection.Above ? "crosses above" : "crosses below")
            </MudChip>
            <MudText Typo="Typo.body2" Class="text-muted">@FormatValueNode(cross.Right)</MudText>
        }
        @if (OnRemove.HasDelegate)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="MudBlazor.Size.Small"
                           OnClick="OnRemove" aria-label="Remove condition" />
        }
    </MudStack>
</MudPaper>

@code {
    [Parameter, EditorRequired] public ConditionNode Node { get; set; } = default!;
    [Parameter] public EventCallback OnRemove { get; set; }

    private static string FormatValueNode(ValueNode node)
    {
        if (node is IndicatorRefNode ind)
            return ind.SubProperty is not null ? $"{ind.IndicatorId}.{ind.SubProperty}" : ind.IndicatorId;
        if (node is PriceRefNode price)
            return price.Field.ToString().ToLower();
        if (node is LiteralNode lit)
            return lit.Value.ToString("G");
        return "?";
    }

    private static string FormatOperator(ComparisonOperator op)
    {
        if (op == ComparisonOperator.GreaterThan) return ">";
        if (op == ComparisonOperator.LessThan) return "<";
        if (op == ComparisonOperator.GreaterThanOrEqual) return ">=";
        if (op == ComparisonOperator.LessThanOrEqual) return "<=";
        if (op == ComparisonOperator.Equal) return "==";
        if (op == ComparisonOperator.NotEqual) return "!=";
        return "?";
    }
}
