@* Step 4: Realism & Risk Profile — preset cards + advanced overrides *@
@using TradingResearchEngine.Application.Strategies
@using TradingResearchEngine.Core.Configuration

<MudText Typo="Typo.h6" Class="mb-3">Realism & Risk Profile</MudText>

<MudText Typo="Typo.body2" Class="text-muted mb-3">
    Choose a preset to configure execution realism and risk settings. You can fine-tune individual settings below.
</MudText>

@* Beginner-mode explanatory text describing default realism settings *@
@if (Model.IsBeginnerMode)
{
    <MudAlert Severity="Severity.Info" Class="mb-3" aria-label="Default realism explanation">
        <MudText Typo="Typo.subtitle2" Class="mb-1">Default Realism: Standard Backtest</MudText>
        <MudText Typo="Typo.body2">
            Your strategy uses the <strong>Standard Backtest</strong> realism profile by default.
            This applies realistic execution assumptions including next-bar-open fills and fixed spread slippage,
            so your backtest results reflect conditions closer to live trading. This prevents misleadingly
            optimistic results that zero-cost profiles can produce.
        </MudText>
    </MudAlert>
}

@if (_validationErrors.Count > 0)
{
    <MudAlert Severity="Severity.Error" Class="mb-3" aria-label="Risk profile validation errors">
        @foreach (var error in _validationErrors)
        {
            <MudText Typo="Typo.body2">@error.Message</MudText>
        }
    </MudAlert>
}

<PresetCards Presets="@Presets"
             SelectedPresetId="@Model.PresetId"
             OnPresetSelected="OnPresetSelected" />

@if (_activePreset is not null && _hasOverrides)
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3" aria-label="Custom preset label">
        Custom (based on @_activePreset.Name)
    </MudAlert>
}

@* In beginner mode, advanced overrides are collapsed and de-emphasized but still accessible *@
@if (Model.IsBeginnerMode)
{
    <MudExpansionPanels Class="mt-4">
        <MudExpansionPanel Text="Advanced Realism Overrides (optional)" Expanded="false"
                           aria-label="Advanced overrides for experienced users">
            <MudText Typo="Typo.caption" Class="text-muted mb-2">
                These settings are for experienced users. The defaults above are suitable for most backtests.
            </MudText>
            <AdvancedOverridesPanel Model="@Model"
                                    PresetName="@(_activePreset?.Name)"
                                    ActivePreset="@_activePreset"
                                    OnModelChanged="OnChanged" />
        </MudExpansionPanel>
    </MudExpansionPanels>
}
else
{
    <div class="mt-4">
        <AdvancedOverridesPanel Model="@Model"
                                PresetName="@(_activePreset?.Name)"
                                ActivePreset="@_activePreset"
                                OnModelChanged="OnChanged" />
    </div>
}

@code {
    [Parameter] public BuilderViewModel Model { get; set; } = default!;
    [Parameter] public IReadOnlyList<ConfigPreset> Presets { get; set; } = Array.Empty<ConfigPreset>();
    [Parameter] public EventCallback OnModelChanged { get; set; }

    private ConfigPreset? _activePreset;
    private bool _hasOverrides;
    private IReadOnlyList<ValidationError> _validationErrors = Array.Empty<ValidationError>();

    protected override void OnParametersSet()
    {
        _activePreset = Presets.FirstOrDefault(p => p.PresetId == Model.PresetId);
        UpdateOverrideStatus();
        RunValidation();
    }

    private void RunValidation()
    {
        _validationErrors = SchemaValidator.ValidateRiskProfile(Model.PresetOverrides, Model.StopLoss);
    }

    private async Task OnPresetSelected(ConfigPreset preset)
    {
        Model.PresetId = preset.PresetId;
        Model.SlippageModelType = preset.ExecutionConfig.SlippageModelType;
        Model.CommissionModelType = preset.ExecutionConfig.CommissionModelType;
        Model.RealismProfile = preset.ExecutionConfig.RealismProfile;
        if (preset.RiskConfig is not null)
        {
            Model.InitialCash = preset.RiskConfig.InitialCash;
            Model.AnnualRiskFreeRate = preset.RiskConfig.AnnualRiskFreeRate;
        }
        Model.PresetOverrides.Clear();
        Model.IsDirty = true;
        _activePreset = preset;
        _hasOverrides = false;
        await OnModelChanged.InvokeAsync();
    }

    private async Task OnChanged()
    {
        Model.IsDirty = true;
        UpdateOverrideStatus();
        RunValidation();
        await OnModelChanged.InvokeAsync();
    }

    private void UpdateOverrideStatus()
    {
        if (_activePreset is null) { _hasOverrides = false; return; }
        _hasOverrides =
            Model.SlippageModelType != _activePreset.ExecutionConfig.SlippageModelType ||
            Model.CommissionModelType != _activePreset.ExecutionConfig.CommissionModelType ||
            (_activePreset.RiskConfig is not null && Model.InitialCash != _activePreset.RiskConfig.InitialCash);
    }
}
