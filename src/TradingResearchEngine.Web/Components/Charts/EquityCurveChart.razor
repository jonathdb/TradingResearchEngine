@rendermode InteractiveServer
@using Plotly.Blazor
@using Plotly.Blazor.Traces
@using Plotly.Blazor.Traces.ScatterLib
@using Plotly.Blazor.LayoutLib
@using Plotly.Blazor.LayoutLib.YAxisLib
@using TradingResearchEngine.Application.Helpers

@if (Curve is not null && Curve.Count > 0)
{
    <PlotlyChart @ref="_chart" Config="_config" Layout="_layout" Data="_data"
                 style="width:100%; height:320px;" />
}

@code {
    /// <summary>The equity curve data points to render.</summary>
    [Parameter] public IReadOnlyList<EquityCurvePoint>? Curve { get; set; }

    /// <summary>Chart title.</summary>
    [Parameter] public string Title { get; set; } = "Equity Curve";

    /// <summary>Whether to show the drawdown overlay on a secondary Y-axis.</summary>
    [Parameter] public bool ShowDrawdown { get; set; }

    private PlotlyChart? _chart;
    private Config _config = new() { Responsive = true, DisplayModeBar = Plotly.Blazor.ConfigLib.DisplayModeBarEnum.Hover };
    private Layout _layout = new();
    private IList<ITrace> _data = new List<ITrace>();

    protected override void OnParametersSet()
    {
        if (Curve is null || Curve.Count == 0) return;

        // Downsample large datasets to prevent dense oscillating appearance
        var displayCurve = Curve.Count > MaxDisplayPoints
            ? Downsample(Curve, MaxDisplayPoints)
            : Curve;

        var timestamps = displayCurve.Select(p => (object)p.Timestamp.DateTime).ToList();
        var equities = displayCurve.Select(p => (object)p.TotalEquity).ToList();

        // Compute tight Y-axis bounds with ±1% padding
        var minEquity = displayCurve.Min(p => p.TotalEquity);
        var maxEquity = displayCurve.Max(p => p.TotalEquity);
        var (yLower, yUpper) = ChartComputationHelpers.ComputeYAxisRange(minEquity, maxEquity);

        _data = new List<ITrace>();

        // Add drawdown trace first so equity line renders above it (higher z-order)
        if (ShowDrawdown)
        {
            var drawdowns = ComputeDrawdownPercent(displayCurve);
            var ddValues = drawdowns.Select(d => (object)d).ToList();

            _data.Add(new Scatter
            {
                X = timestamps,
                Y = ddValues,
                Name = "Drawdown %",
                Mode = ModeFlag.Lines,
                Fill = FillEnum.ToZeroY,
                Line = new Line { Color = "rgba(244,67,54,0.4)", Width = 1m },
                FillColor = "rgba(244,67,54,0.15)",
                YAxis = "y2",
                HoverTemplate = "Drawdown: %{y:.1f}%<extra></extra>"
            });
        }

        // Equity line added after drawdown so it renders on top
        _data.Add(new Scatter
        {
            X = timestamps,
            Y = equities,
            Name = "Total Equity",
            Mode = ModeFlag.Lines,
            Line = new Line { Color = "#42A5F5", Width = 2m },
            HoverTemplate = "Date: %{x}<br>Equity: $%{y:,.0f}<extra></extra>"
        });

        _layout = new Layout
        {
            Title = new Plotly.Blazor.LayoutLib.Title { Text = Title },
            Margin = new Plotly.Blazor.LayoutLib.Margin { L = 60, R = 60, T = 40, B = 40 },
            HoverMode = Plotly.Blazor.LayoutLib.HoverModeEnum.XUnified,
            ShowLegend = true,
            Legend = new List<Plotly.Blazor.LayoutLib.Legend> { new() { Orientation = Plotly.Blazor.LayoutLib.LegendLib.OrientationEnum.H, Y = -0.15m } },
            XAxis = new[] { new Plotly.Blazor.LayoutLib.XAxis
            {
                Title = new Plotly.Blazor.LayoutLib.XAxisLib.Title { Text = "" },
                ShowSpikes = true,
                SpikeMode = Plotly.Blazor.LayoutLib.XAxisLib.SpikeModeFlag.Across,
                SpikeColor = "rgba(255,255,255,0.3)",
                SpikeThickness = 1m,
                SpikeDash = "dot",
                SpikeSnap = Plotly.Blazor.LayoutLib.XAxisLib.SpikeSnapEnum.Cursor
            } }.ToList(),
            YAxis = new[] { new YAxis { Title = new Plotly.Blazor.LayoutLib.YAxisLib.Title { Text = "Equity ($)" }, Range = new List<object> { (decimal)yLower, (decimal)yUpper } } }.ToList()
        };

        if (ShowDrawdown)
        {
            _layout.YAxis.Add(new YAxis
            {
                Title = new Plotly.Blazor.LayoutLib.YAxisLib.Title { Text = "Drawdown %" },
                Overlaying = "y",
                Side = Plotly.Blazor.LayoutLib.YAxisLib.SideEnum.Right,
                ShowGrid = false
            });
        }
    }

    /// <summary>Maximum number of data points to display. Beyond this, LTTB downsampling is applied.
    /// Exposed as a parameter so parent components can pass a responsive value based on container width.</summary>
    [Parameter] public int MaxDisplayPoints { get; set; } = 800;

    private static List<decimal> ComputeDrawdownPercent(IReadOnlyList<EquityCurvePoint> curve)
    {
        var result = new List<decimal>(curve.Count);
        decimal peak = curve[0].TotalEquity;
        foreach (var p in curve)
        {
            if (p.TotalEquity > peak) peak = p.TotalEquity;
            var dd = peak > 0 ? (p.TotalEquity - peak) / peak * 100m : 0m;
            result.Add(dd);
        }
        return result;
    }

    /// <summary>
    /// Largest-Triangle-Three-Buckets (LTTB) downsampling algorithm.
    /// Preserves visual shape of the curve while reducing point count.
    /// Always keeps first and last points.
    /// </summary>
    private static IReadOnlyList<EquityCurvePoint> Downsample(IReadOnlyList<EquityCurvePoint> data, int targetCount)
    {
        if (data.Count <= targetCount) return data;
        if (targetCount < 3) return new[] { data[0], data[^1] };

        var result = new List<EquityCurvePoint>(targetCount) { data[0] };
        double bucketSize = (double)(data.Count - 2) / (targetCount - 2);

        int prevIndex = 0;
        for (int i = 0; i < targetCount - 2; i++)
        {
            int bucketStart = (int)Math.Floor((i + 1) * bucketSize) + 1;
            int bucketEnd = (int)Math.Floor((i + 2) * bucketSize) + 1;
            if (bucketEnd >= data.Count) bucketEnd = data.Count - 1;

            // Compute average of next bucket for the triangle area calculation
            int nextBucketStart = bucketEnd;
            int nextBucketEnd = (int)Math.Floor((i + 3) * bucketSize) + 1;
            if (nextBucketEnd >= data.Count) nextBucketEnd = data.Count - 1;

            double avgX = 0, avgY = 0;
            int nextCount = nextBucketEnd - nextBucketStart;
            if (nextCount <= 0) { nextCount = 1; nextBucketEnd = nextBucketStart + 1; }
            for (int j = nextBucketStart; j < nextBucketEnd && j < data.Count; j++)
            {
                avgX += j;
                avgY += (double)data[j].TotalEquity;
            }
            avgX /= nextCount;
            avgY /= nextCount;

            // Find point in current bucket with largest triangle area
            double maxArea = -1;
            int maxIndex = bucketStart;
            double prevX = prevIndex;
            double prevY = (double)data[prevIndex].TotalEquity;

            for (int j = bucketStart; j < bucketEnd && j < data.Count; j++)
            {
                double area = Math.Abs(
                    (prevX - avgX) * ((double)data[j].TotalEquity - prevY) -
                    (prevX - j) * (avgY - prevY));
                if (area > maxArea)
                {
                    maxArea = area;
                    maxIndex = j;
                }
            }

            result.Add(data[maxIndex]);
            prevIndex = maxIndex;
        }

        result.Add(data[^1]);
        return result;
    }
}
