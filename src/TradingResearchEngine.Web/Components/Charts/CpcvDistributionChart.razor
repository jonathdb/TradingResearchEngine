@rendermode InteractiveServer
@using Plotly.Blazor
@using Plotly.Blazor.Traces
@using TradingResearchEngine.Application.Helpers

@if (_canRender)
{
    <PlotlyChart @ref="_chart" Config="_config" Layout="_layout" Data="_data"
                 style="width:100%; height:350px;" />
}

@code {
    /// <summary>OOS Sharpe distribution values from CpcvResult.</summary>
    [Parameter] public IReadOnlyList<decimal> OosSharpeDistribution { get; set; } = Array.Empty<decimal>();

    private const int BinCount = 20;

    private PlotlyChart? _chart;
    private Config _config = new() { Responsive = true, DisplayModeBar = Plotly.Blazor.ConfigLib.DisplayModeBarEnum.Hover };
    private Layout _layout = new();
    private IList<ITrace> _data = new List<ITrace>();
    private bool _canRender;

    protected override void OnParametersSet()
    {
        if (OosSharpeDistribution.Count == 0)
        {
            _canRender = false;
            return;
        }

        _canRender = true;
        BuildChart();
    }

    private void BuildChart()
    {
        var bins = ChartComputationHelpers.BinValues(OosSharpeDistribution.ToList(), BinCount);
        if (bins.Count == 0)
        {
            _canRender = false;
            return;
        }

        // Compute bin midpoints for X-axis labels and coloring
        var midpoints = bins.Select(b => (object)(double)((b.LowerBound + b.UpperBound) / 2m)).ToList();
        var counts = bins.Select(b => (object)b.Count).ToList();

        // Color bars by midpoint Sharpe value: red < 0, yellow 0-1, green >= 1
        var colors = bins.Select(b =>
        {
            var mid = (b.LowerBound + b.UpperBound) / 2m;
            return mid switch
            {
                < 0m => "rgba(239,83,80,0.7)",   // red
                < 1m => "rgba(255,193,7,0.7)",    // yellow
                _ => "rgba(102,187,106,0.7)"      // green
            };
        }).Cast<object>().ToList();

        _data = new List<ITrace>
        {
            new Bar
            {
                X = midpoints,
                Y = counts,
                Name = "OOS Sharpe",
                Marker = new Plotly.Blazor.Traces.BarLib.Marker { Color = colors as IList<object> },
                HoverTemplate = "Sharpe: %{x:.2f}<br>Count: %{y}<extra></extra>"
            }
        };

        // Compute median from the raw distribution
        var sorted = OosSharpeDistribution.OrderBy(v => v).ToList();
        var median = (double)sorted[sorted.Count / 2];

        _layout = new Layout
        {
            Title = new Plotly.Blazor.LayoutLib.Title { Text = "CPCV OOS Sharpe Distribution" },
            Margin = new Plotly.Blazor.LayoutLib.Margin { L = 60, R = 40, T = 50, B = 50 },
            BarGap = 0.05m,
            XAxis = new[] { new Plotly.Blazor.LayoutLib.XAxis
            {
                Title = new Plotly.Blazor.LayoutLib.XAxisLib.Title { Text = "OOS Sharpe Ratio" }
            } }.ToList(),
            YAxis = new[] { new Plotly.Blazor.LayoutLib.YAxis
            {
                Title = new Plotly.Blazor.LayoutLib.YAxisLib.Title { Text = "Frequency" }
            } }.ToList(),
            Shapes = new List<Plotly.Blazor.LayoutLib.Shape>
            {
                // Vertical dashed line at zero
                new Plotly.Blazor.LayoutLib.Shape
                {
                    Type = Plotly.Blazor.LayoutLib.ShapeLib.TypeEnum.Line,
                    X0 = (object)0.0,
                    X1 = (object)0.0,
                    Y0 = (object)0,
                    Y1 = (object)1,
                    YRef = "paper",
                    Line = new Plotly.Blazor.LayoutLib.ShapeLib.Line
                    {
                        Color = "#EF5350",
                        Width = 2m,
                        Dash = "dash"
                    }
                },
                // Vertical dashed line at median Sharpe
                new Plotly.Blazor.LayoutLib.Shape
                {
                    Type = Plotly.Blazor.LayoutLib.ShapeLib.TypeEnum.Line,
                    X0 = (object)median,
                    X1 = (object)median,
                    Y0 = (object)0,
                    Y1 = (object)1,
                    YRef = "paper",
                    Line = new Plotly.Blazor.LayoutLib.ShapeLib.Line
                    {
                        Color = "#42A5F5",
                        Width = 2m,
                        Dash = "dash"
                    }
                }
            }
        };
    }
}
