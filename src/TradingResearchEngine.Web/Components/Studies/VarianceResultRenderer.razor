@using TradingResearchEngine.Application.Research
@using TradingResearchEngine.Application.Research.Results
@using System.Text.Json

@if (_result is not null)
{
    <MudTable Items="_result.Variants" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>Preset</MudTh><MudTh>Sharpe</MudTh><MudTh>Max DD</MudTh>
            <MudTh>Win Rate</MudTh><MudTh>Trades</MudTh><MudTh>End Equity</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd><MudChip T="string" Size="MudBlazor.Size.Small">@context.PresetName</MudChip></MudTd>
            <MudTd>@(context.Result.SharpeRatio?.ToString("F2") ?? "N/A")</MudTd>
            <MudTd>@context.Result.MaxDrawdown.ToString("P2")</MudTd>
            <MudTd>@(context.Result.WinRate?.ToString("P1") ?? "N/A")</MudTd>
            <MudTd>@context.Result.TotalTrades</MudTd>
            <MudTd>$@context.Result.EndEquity.ToString("F2")</MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    [Parameter] public StudyRecord Study { get; set; } = default!;
    [Parameter] public string ResultJson { get; set; } = "";

    private VarianceResult? _result;

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(ResultJson))
            _result = JsonSerializer.Deserialize<VarianceResult>(ResultJson);
    }
}
