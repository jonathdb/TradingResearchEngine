@inject NavigationManager Nav

<div style="position:fixed; inset:0; z-index:2000; background:rgba(0,0,0,0.72); display:flex; align-items:center; justify-content:center; backdrop-filter:blur(4px);"
     @onclick="Close" @onkeydown="OnKeyDown" tabindex="0">
    <MudPaper Class="pa-6" Elevation="8"
              Style="min-width:340px; max-width:500px; border:1px solid var(--mud-palette-divider); border-radius:var(--tre-radius);"
              @onclick:stopPropagation="true">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Outlined.Keyboard" Style="opacity:0.6;" />
                <MudText Typo="Typo.h6">Keyboard Shortcuts</MudText>
            </MudStack>
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="MudBlazor.Size.Small"
                           OnClick="Close" Style="opacity:0.5;" />
        </MudStack>

        <MudSimpleTable Dense="true" Hover="true" aria-label="Keyboard shortcuts reference"
                        Style="background:transparent;">
            <thead>
                <tr>
                    <th style="font-size:0.68rem; opacity:0.5; padding-bottom:8px;">SHORTCUT</th>
                    <th style="font-size:0.68rem; opacity:0.5; padding-bottom:8px;">ACTION</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><kbd style="@_kbdStyle">N</kbd></td>
                    <td><MudText Typo="Typo.body2">New Strategy</MudText></td>
                </tr>
                <tr>
                    <td><kbd style="@_kbdStyle">R</kbd></td>
                    <td><MudText Typo="Typo.body2">Re-run last config</MudText></td>
                </tr>
                <tr>
                    <td><kbd style="@_kbdStyle">?</kbd></td>
                    <td><MudText Typo="Typo.body2">Show this overlay</MudText></td>
                </tr>
                <tr>
                    <td><kbd style="@_kbdStyle">Esc</kbd></td>
                    <td><MudText Typo="Typo.body2">Close modal / cancel</MudText></td>
                </tr>
            </tbody>
        </MudSimpleTable>

        <MudText Typo="Typo.caption" Class="text-faint mt-4" Style="display:block; text-align:center;">
            Press Esc or click outside to close
        </MudText>
    </MudPaper>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private const string _kbdStyle =
        "display:inline-block; padding:2px 7px; background:rgba(255,255,255,0.08); " +
        "border:1px solid rgba(255,255,255,0.18); border-radius:4px; " +
        "font-family:monospace; font-size:0.78rem; color:var(--mud-palette-text-primary);";

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await Close();
    }

    public void HandleGlobalKey(string key)
    {
        switch (key)
        {
            case "n" or "N": Nav.NavigateTo("/strategies/builder"); break;
        }
    }
}
