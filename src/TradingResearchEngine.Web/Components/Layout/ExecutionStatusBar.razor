@inject TradingResearchEngine.Application.Research.BackgroundStudyService StudyService
@inject TradingResearchEngine.Application.Research.JobExecutor JobExecutor
@inject NavigationManager Nav
@implements IDisposable

@if (_activeStudies.Count > 0 || _recentCompletions.Count > 0 || _activeJobs.Count > 0)
{
    <div class="execution-bar" role="status" aria-label="Execution status">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Style="width:100%;" Wrap="Wrap.Wrap">

            @* Active backtest jobs *@
            @foreach (var job in _activeJobs)
            {
                var pct     = (double)(job.Progress?.Percentage ?? 0m);
                var stage   = job.Progress?.Stage ?? "Queued";
                var current = job.Progress?.Current ?? 0;
                var total   = job.Progress?.Total ?? 0;
                var elapsed = job.Progress?.ElapsedTime ?? TimeSpan.Zero;

                <div class="execution-bar__job" aria-label="@($"{job.JobType}: {pct:F0}%")">
                    <MudIcon Icon="@Icons.Material.Filled.Loop"
                             Style="font-size:0.9rem; color:var(--mud-palette-primary); animation: spin 2s linear infinite;" />
                    <MudText Typo="Typo.caption" Style="font-weight:600; white-space:nowrap;">
                        @job.JobType
                    </MudText>
                    <MudText Typo="Typo.caption" Class="text-muted" Style="white-space:nowrap;">
                        @stage · @pct.ToString("F0")%
                    </MudText>
                    <MudProgressLinear Value="@pct" Style="width:72px; height:4px; border-radius:2px;" Color="Color.Primary" />
                    <MudText Typo="Typo.caption" Class="text-faint" Style="white-space:nowrap; font-variant-numeric: tabular-nums;">
                        @current/@total · @elapsed.ToString(@"mm\:ss")
                    </MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.StopCircle" Size="MudBlazor.Size.Small"
                                   Color="Color.Error" Style="padding:2px; margin:-2px;"
                                   OnClick="@(() => CancelJob(job.JobId))"
                                   aria-label="Cancel job" />
                </div>
            }

            @* Active research studies *@
            @foreach (var study in _activeStudies)
            {
                var pct     = study.Total > 0 ? (100.0 * study.Current / study.Total) : 0.0;
                var elapsed = DateTimeOffset.UtcNow - study.StartedAt;

                <div class="execution-bar__job" aria-label="@($"Study {study.Type}: {pct:F0}%")">
                    <MudIcon Icon="@Icons.Material.Filled.Loop"
                             Style="font-size:0.9rem; color:var(--mud-palette-secondary); animation: spin 2s linear infinite;" />
                    <MudText Typo="Typo.caption" Style="font-weight:600; white-space:nowrap;">@study.Type</MudText>
                    <MudText Typo="Typo.caption" Class="text-muted" Style="white-space:nowrap;">
                        @GetStrategyLabel(study) · @pct.ToString("F0")%
                    </MudText>
                    @if (study.Total > 0)
                    {
                        <MudProgressLinear Value="@pct" Style="width:72px; height:4px; border-radius:2px;" Color="Color.Secondary" />
                    }
                    else
                    {
                        <MudProgressLinear Indeterminate="true" Style="width:72px; height:4px; border-radius:2px;" Color="Color.Secondary" />
                    }
                    <MudText Typo="Typo.caption" Class="text-faint" Style="white-space:nowrap; font-variant-numeric: tabular-nums;">
                        @study.Current/@study.Total · @elapsed.ToString(@"mm\:ss")
                    </MudText>
                    <MudIconButton Icon="@Icons.Material.Outlined.OpenInNew" Size="MudBlazor.Size.Small"
                                   Color="Color.Inherit" Style="padding:2px; margin:-2px; opacity:0.6;"
                                   OnClick="@(() => Nav.NavigateTo($"/research/study/{study.StudyId}"))"
                                   aria-label="View study" />
                    <MudIconButton Icon="@Icons.Material.Filled.StopCircle" Size="MudBlazor.Size.Small"
                                   Color="Color.Error" Style="padding:2px; margin:-2px;"
                                   OnClick="@(() => StudyService.CancelStudy(study.StudyId))"
                                   aria-label="Cancel study" />
                </div>
            }

            @* Recent completions *@
            @foreach (var c in _recentCompletions)
            {
                var success = c.Status == TradingResearchEngine.Application.Research.StudyStatus.Completed;
                <div class="execution-bar__job" style="border-color: @(success ? "rgba(76,175,116,0.3)" : "rgba(224,92,92,0.3)"); background: @(success ? "rgba(76,175,116,0.08)" : "rgba(224,92,92,0.08)");">
                    <MudIcon Icon="@(success ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Error)"
                             Style="@($"font-size:0.9rem; color:{( success ? "var(--mud-palette-success)" : "var(--mud-palette-error)")}")" />
                    <MudText Typo="Typo.caption" Style="font-weight:600; white-space:nowrap;">
                        @(success ? "Completed" : "Failed")
                    </MudText>
                    <MudText Typo="Typo.caption" Class="text-faint monospace" Style="white-space:nowrap;">
                        @c.StudyId[..Math.Min(8, c.StudyId.Length)]…
                    </MudText>
                    <MudButton Size="MudBlazor.Size.Small" Variant="Variant.Text"
                               Style="padding: 1px 6px; min-width:0; height:22px; font-size:0.7rem;"
                               OnClick="@(() => Nav.NavigateTo($"/research/study/{c.StudyId}"))">
                        View
                    </MudButton>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="MudBlazor.Size.Small"
                                   Style="padding:2px; margin:-2px; opacity:0.5;"
                                   OnClick="@(() => DismissCompletion(c.StudyId))"
                                   aria-label="Dismiss" />
                </div>
            }

        </MudStack>
    </div>
}

<style>
    @@keyframes spin {
        from { transform: rotate(0deg); }
        to   { transform: rotate(360deg); }
    }
</style>

@code {
    private List<TradingResearchEngine.Application.Research.ActiveStudy> _activeStudies = new();
    private List<TradingResearchEngine.Application.Research.StudyCompletionUpdate> _recentCompletions = new();
    private List<TradingResearchEngine.Application.Research.BacktestJob> _activeJobs = new();
    private System.Timers.Timer? _pollTimer;

    protected override void OnInitialized()
    {
        StudyService.OnProgress  += OnProgress;
        StudyService.OnCompleted += OnCompleted;
        _activeStudies = StudyService.GetActiveStudies().ToList();

        _pollTimer = new System.Timers.Timer(2000);
        _pollTimer.Elapsed += async (_, _) => await PollJobProgress();
        _pollTimer.Start();
    }

    private async Task PollJobProgress()
    {
        try
        {
            var jobs = await JobExecutor.ListJobsAsync();
            _activeJobs = jobs
                .Where(j => j.Status == TradingResearchEngine.Application.Research.JobStatus.Running
                         || j.Status == TradingResearchEngine.Application.Research.JobStatus.Queued)
                .ToList();
            await InvokeAsync(StateHasChanged);
        }
        catch { /* Silently ignore polling errors */ }
    }

    private void CancelJob(string jobId)
    {
        _ = JobExecutor.CancelAsync(jobId);
        _activeJobs.RemoveAll(j => j.JobId == jobId);
        StateHasChanged();
    }

    private void OnProgress(TradingResearchEngine.Application.Research.StudyProgressUpdate update)
    {
        _activeStudies = StudyService.GetActiveStudies().ToList();
        InvokeAsync(StateHasChanged);
    }

    private void OnCompleted(TradingResearchEngine.Application.Research.StudyCompletionUpdate update)
    {
        _activeStudies = StudyService.GetActiveStudies().ToList();
        _recentCompletions.Add(update);
        InvokeAsync(StateHasChanged);
    }

    private void DismissCompletion(string studyId)
    {
        _recentCompletions.RemoveAll(c => c.StudyId == studyId);
        StateHasChanged();
    }

    private static string GetStrategyLabel(TradingResearchEngine.Application.Research.ActiveStudy study) =>
        study.StrategyVersionId.Length > 10
            ? study.StrategyVersionId[..10] + "…"
            : study.StrategyVersionId;

    public void Dispose()
    {
        StudyService.OnProgress  -= OnProgress;
        StudyService.OnCompleted -= OnCompleted;
        _pollTimer?.Stop();
        _pollTimer?.Dispose();
    }
}
