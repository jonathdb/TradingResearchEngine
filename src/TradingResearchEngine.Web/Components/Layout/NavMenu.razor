@inject IJSRuntime JS
@inject NavigationManager Nav

<MudNavMenu Dense="true" Style="padding: 4px 0;">

    @* ── Dashboard ── *@
    <MudNavLink Href="/" Match="NavLinkMatch.All"
                Icon="@Icons.Material.Outlined.Dashboard"
                IconColor="Color.Inherit">
        Dashboard
    </MudNavLink>

    @* ── Strategies ── *@
    <div class="nav-section-label">Strategies</div>
    <MudNavGroup @bind-Expanded="_strategiesExpanded" Icon="@Icons.Material.Outlined.Psychology"
                 IconColor="Color.Inherit" Title="Strategies" HideExpandIcon="false">
        <MudNavLink Href="/strategies/library" Icon="@Icons.Material.Outlined.ViewList">My Strategies</MudNavLink>
        <MudNavLink Href="/strategies/builder"  Icon="@Icons.Material.Outlined.AddCircleOutline">New Strategy</MudNavLink>
    </MudNavGroup>

    @* ── Research ── *@
    <div class="nav-section-label">Research</div>
    <MudNavGroup @bind-Expanded="_researchExpanded" Icon="@Icons.Material.Outlined.Science"
                 IconColor="Color.Inherit" Title="Research" HideExpandIcon="false">
        <MudNavLink Href="/research/explorer"    Icon="@Icons.Material.Outlined.Explore">Explorer</MudNavLink>
        <MudNavLink Href="/research/sweep"       Icon="@Icons.Material.Outlined.GridOn">Parameter Sweep</MudNavLink>
        <MudNavLink Href="/research/montecarlo"  Icon="@Icons.Material.Outlined.Casino">Monte Carlo</MudNavLink>
        <div class="nav-inner-label">Analysis Tools</div>
        <MudNavLink Href="/research/walkforward" Icon="@Icons.Material.Outlined.Timeline">Walk-Forward</MudNavLink>
        <MudNavLink Href="/research/perturbation" Icon="@Icons.Material.Outlined.Tune">Perturbation</MudNavLink>
        <MudNavLink Href="/research/variance"    Icon="@Icons.Material.Outlined.BarChart">Variance</MudNavLink>
        <MudNavLink Href="/research/benchmark"   Icon="@Icons.Material.Outlined.Leaderboard">Benchmark</MudNavLink>
    </MudNavGroup>

    @* ── Backtests ── *@
    <div class="nav-section-label">Backtests</div>
    <MudNavLink Href="/backtests" Icon="@Icons.Material.Outlined.History">Backtest History</MudNavLink>
    <MudNavLink Href="/compare" Icon="@Icons.Material.Outlined.CompareArrows">Strategy Comparison</MudNavLink>

    @* ── Robustness ── *@
    <div class="nav-section-label">Robustness</div>
    <MudNavLink Href="/robustness-hub" Icon="@Icons.Material.Outlined.Security">Robustness Hub</MudNavLink>

    @* ── Prop Firm Lab ── *@
    <div class="nav-section-label">Prop Firm</div>
    <MudNavLink Href="/propfirm/evaluate" Icon="@Icons.Material.Outlined.AccountBalance">Prop Firm Lab</MudNavLink>
    <MudNavLink Href="/paper-trading"     Icon="@Icons.Material.Outlined.PlayCircleOutline">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <span>Paper Trading</span>
            <MudChip T="string" Size="MudBlazor.Size.Small" Color="Color.Warning"
                     Style="height:16px; font-size:0.58rem; padding:0 5px; margin:0;">BETA</MudChip>
        </MudStack>
    </MudNavLink>

    @* ── Data ── *@
    <div class="nav-section-label">Data</div>
    <MudNavGroup @bind-Expanded="_dataExpanded" Icon="@Icons.Material.Outlined.Storage"
                 IconColor="Color.Inherit" Title="Data" HideExpandIcon="false">
        <MudNavLink Href="/market-data" Icon="@Icons.Material.Outlined.CloudDownload">Market Data</MudNavLink>
        <MudNavLink Href="/data"        Icon="@Icons.Material.Outlined.FolderOpen">Data Files</MudNavLink>
    </MudNavGroup>

</MudNavMenu>

@code {
    private bool _strategiesExpanded = true;
    private bool _researchExpanded = false;
    private bool _dataExpanded = false;
    private bool _initialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _strategiesExpanded = await JS.InvokeAsync<bool>("navMenuState.get", "strategies");
            _researchExpanded   = await JS.InvokeAsync<bool>("navMenuState.get", "research");
            _dataExpanded       = await JS.InvokeAsync<bool>("navMenuState.get", "data");
            _initialized = true;
            StateHasChanged();
        }
        else if (_initialized)
        {
            await JS.InvokeVoidAsync("navMenuState.set", "strategies", _strategiesExpanded);
            await JS.InvokeVoidAsync("navMenuState.set", "research",   _researchExpanded);
            await JS.InvokeVoidAsync("navMenuState.set", "data",       _dataExpanded);
        }
    }
}
