@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true" Style="border-bottom: 1px solid var(--mud-palette-divider); backdrop-filter: blur(8px);">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit"
                       Edge="Edge.Start" OnClick="ToggleDrawer" Class="mr-1" />

        <a href="/" class="app-logo ml-1">
            <span class="app-logo__icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="3" y="9"  width="3" height="12" rx="1.5" fill="currentColor" opacity="0.5"/>
                    <rect x="9" y="4"  width="3" height="17" rx="1.5" fill="currentColor"/>
                    <rect x="15" y="7" width="3" height="14" rx="1.5" fill="currentColor" opacity="0.7"/>
                    <rect x="21" y="11" width="1.5" height="10" rx="0.75" fill="currentColor" opacity="0.35"/>
                </svg>
            </span>
            <MudText Typo="Typo.subtitle1" Style="font-weight:700; letter-spacing:-0.01em; color: var(--mud-palette-text-primary);">
                Research Engine
            </MudText>
        </a>

        <MudSpacer />

        <GlobalSearch />

        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mr-2">
            <MudTooltip Text="Keyboard Shortcuts (?)">
                <MudIconButton Icon="@Icons.Material.Outlined.Keyboard" Color="Color.Inherit" Size="MudBlazor.Size.Small"
                               OnClick="ToggleShortcuts" />
            </MudTooltip>
            <MudChip T="string" Size="MudBlazor.Size.Small" Variant="Variant.Outlined"
                     Style="height:22px; font-size:0.65rem; opacity:0.5; pointer-events:none;">v4.0</MudChip>
        </MudStack>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0"
               Style="border-right: 1px solid var(--mud-palette-divider);">
        <MudDrawerContainer Style="display:flex; flex-direction:column; height:100%;">
            <div style="flex:1; overflow-y:auto; padding-top: 8px;">
                <NavMenu />
            </div>
            <div class="drawer-footer">
                <MudText Typo="Typo.caption" Class="text-faint" Style="font-size:0.62rem;">
                    Trading Research Engine
                </MudText>
                <MudTooltip Text="Settings">
                    <MudIconButton Icon="@Icons.Material.Outlined.Settings" Size="MudBlazor.Size.Small"
                                   Color="Color.Inherit" Style="opacity:0.45;" Href="/settings" />
                </MudTooltip>
            </div>
        </MudDrawerContainer>
    </MudDrawer>

    <MudMainContent Style="padding-top: 64px; padding-left: 20px; padding-right: 20px; padding-bottom: 56px;">
        <div class="fade-in">
            @Body
        </div>
    </MudMainContent>

    <ExecutionStatusBar />

    @if (_showShortcuts)
    {
        <KeyboardShortcutOverlay OnClose="ToggleShortcuts" />
    }
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _showShortcuts;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    private void ToggleShortcuts() => _showShortcuts = !_showShortcuts;

    private readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark
        {
            // ── Accent ──────────────────────────────────────────────
            Primary         = "#60A5FA",   // bright sky blue — readable and electric
            PrimaryDarken   = "#3B82F6",
            PrimaryLighten  = "#93C5FD",
            Secondary       = "#818CF8",   // indigo — warm complement to blue
            SecondaryDarken = "#6366F1",
            Info            = "#38BDF8",   // cyan info
            Success         = "#34D399",   // emerald green
            Warning         = "#FBBF24",   // amber — pops against navy
            Error           = "#F87171",   // soft red

            // ── Chrome ──────────────────────────────────────────────
            AppbarBackground = "#0D1117",  // deepest — GitHub-style near-black navy
            AppbarText       = "#F0F6FC",

            // ── Backgrounds (4 depth levels) ────────────────────────
            Background       = "#0D1117",  // page canvas
            BackgroundGray   = "#161B22",  // slightly raised (drawer, sidebar)
            Surface          = "#1C2330",  // cards / papers — clearly distinct from bg
            DrawerBackground = "#161B22",
            DrawerText       = "#CDD9E5",
            DrawerIcon       = "#768390",

            // ── Borders & Lines ─────────────────────────────────────
            Divider          = "rgba(99,130,162,0.15)",   // blue-tinted dividers
            DividerLight     = "rgba(99,130,162,0.08)",
            LinesDefault     = "rgba(99,130,162,0.10)",
            LinesInputs      = "rgba(99,130,162,0.30)",
            TableLines       = "rgba(99,130,162,0.10)",
            TableHover       = "rgba(96,165,250,0.07)",
            TableStriped     = "rgba(255,255,255,0.02)",

            // ── Text ────────────────────────────────────────────────
            TextPrimary      = "#F0F6FC",  // crisp white with slight blue cast
            TextSecondary    = "#8B949E",
            TextDisabled     = "rgba(139,148,158,0.45)",
            ActionDefault    = "#8B949E",

            // ── Overlays ────────────────────────────────────────────
            OverlayLight     = "rgba(13,17,23,0.6)",
            OverlayDark      = "rgba(13,17,23,0.85)",
        },
        Typography = new Typography
        {
            Default   = new DefaultTypography { FontFamily = new[] { "Inter", "system-ui", "sans-serif" } },
            H4        = new H4Typography     { FontWeight = "700", LetterSpacing = "-0.025em" },
            H5        = new H5Typography     { FontWeight = "700", LetterSpacing = "-0.02em" },
            H6        = new H6Typography     { FontWeight = "600", LetterSpacing = "-0.01em" },
            Subtitle1 = new Subtitle1Typography { FontWeight = "600" },
            Subtitle2 = new Subtitle2Typography { FontWeight = "600", LetterSpacing = "0.005em" },
            Body1     = new Body1Typography  { FontSize = "0.875rem", LineHeight = "1.6" },
            Body2     = new Body2Typography  { FontSize = "0.8125rem", LineHeight = "1.55" },
            Caption   = new CaptionTypography { FontSize = "0.72rem", LetterSpacing = "0.01em" },
        },
        LayoutProperties = new LayoutProperties
        {
            DrawerWidthLeft     = "224px",
            AppbarHeight        = "52px",
            DefaultBorderRadius = "8px",
        }
    };
}
