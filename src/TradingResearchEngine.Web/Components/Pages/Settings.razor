@page "/settings"
@inject Microsoft.Extensions.Options.IOptions<TradingResearchEngine.Application.Configuration.RiskOptions> RiskOpts
@inject Microsoft.Extensions.Options.IOptions<TradingResearchEngine.Application.Configuration.MonteCarloOptions> McOpts
@inject Microsoft.Extensions.Options.IOptions<TradingResearchEngine.Application.Configuration.ReportingOptions> ReportOpts
@inject Microsoft.Extensions.Options.IOptions<TradingResearchEngine.Application.Configuration.SweepOptions> SweepOpts
@inject Microsoft.Extensions.Options.IOptions<TradingResearchEngine.Application.Configuration.RepositoryOptions> RepoOpts
@inject TradingResearchEngine.Infrastructure.DataProviders.DataFileService DataService
@inject TradingResearchEngine.Infrastructure.Settings.SettingsService SettingsService
@inject StrategyRegistry Registry

<PageTitle>Settings — Research Engine</PageTitle>

<div class="page-header">
    <div class="page-header__title">
        <MudText Typo="Typo.h5">Settings</MudText>
        <MudText Typo="Typo.caption" Class="text-muted">
            Read-only configuration values — edit <code style="font-size:0.75em; opacity:0.8;">appsettings.json</code> to change defaults
        </MudText>
    </div>
</div>

<MudGrid Spacing="3">

    @* ── Left Column ── *@
    <MudItem xs="12" md="6">

        @* Risk Defaults *@
        <MudPaper Class="pa-4 mb-3" Elevation="1" Style="border-radius:var(--tre-radius);">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Outlined.Shield" Style="color:var(--mud-palette-warning); font-size:1.1rem;" />
                <MudText Typo="Typo.subtitle2">Risk Defaults</MudText>
            </MudStack>
            <div class="settings-table">
                <div class="settings-row">
                    <span class="settings-key">Max Exposure</span>
                    <span class="settings-val">@RiskOpts.Value.MaxExposurePercent%</span>
                </div>
            </div>
        </MudPaper>

        @* Monte Carlo *@
        <MudPaper Class="pa-4 mb-3" Elevation="1" Style="border-radius:var(--tre-radius);">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Outlined.Casino" Style="color:var(--mud-palette-primary); font-size:1.1rem;" />
                <MudText Typo="Typo.subtitle2">Monte Carlo Defaults</MudText>
            </MudStack>
            <div class="settings-table">
                <div class="settings-row">
                    <span class="settings-key">Simulation Count</span>
                    <span class="settings-val monospace">@McOpts.Value.SimulationCount.ToString("N0")</span>
                </div>
                <div class="settings-row">
                    <span class="settings-key">Ruin Threshold</span>
                    <span class="settings-val monospace">@McOpts.Value.RuinThresholdPercent.ToString("P0")</span>
                </div>
                <div class="settings-row">
                    <span class="settings-key">Random Seed</span>
                    <span class="settings-val monospace">@(McOpts.Value.Seed?.ToString() ?? "Random")</span>
                </div>
            </div>
        </MudPaper>

        @* Sweep *@
        <MudPaper Class="pa-4" Elevation="1" Style="border-radius:var(--tre-radius);">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Outlined.GridOn" Style="color:var(--mud-palette-secondary); font-size:1.1rem;" />
                <MudText Typo="Typo.subtitle2">Parameter Sweep</MudText>
            </MudStack>
            <div class="settings-table">
                <div class="settings-row">
                    <span class="settings-key">Max Parallelism</span>
                    <span class="settings-val monospace">@SweepOpts.Value.MaxDegreeOfParallelism</span>
                </div>
            </div>
        </MudPaper>

    </MudItem>

    @* ── Right Column ── *@
    <MudItem xs="12" md="6">

        @* Reporting *@
        <MudPaper Class="pa-4 mb-3" Elevation="1" Style="border-radius:var(--tre-radius);">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Outlined.Assessment" Style="color:var(--mud-palette-info); font-size:1.1rem;" />
                <MudText Typo="Typo.subtitle2">Reporting</MudText>
            </MudStack>
            <div class="settings-table">
                <div class="settings-row">
                    <span class="settings-key">Decimal Places</span>
                    <span class="settings-val monospace">@ReportOpts.Value.DecimalPlaces</span>
                </div>
            </div>
        </MudPaper>

        @* Storage *@
        <MudPaper Class="pa-4 mb-3" Elevation="1" Style="border-radius:var(--tre-radius);">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Outlined.Storage" Style="color:var(--mud-palette-primary); font-size:1.1rem;" />
                <MudText Typo="Typo.subtitle2">Storage Paths</MudText>
            </MudStack>
            <div class="settings-table">
                <div class="settings-row settings-row--wrap">
                    <span class="settings-key">Repository</span>
                    <span class="settings-val monospace" style="word-break:break-all; font-size:0.75rem;">
                        @(string.IsNullOrEmpty(RepoOpts.Value.BaseDirectory) ? "(default: LocalAppData)" : RepoOpts.Value.BaseDirectory)
                    </span>
                </div>
                <div class="settings-row settings-row--wrap">
                    <span class="settings-key">Data Directory</span>
                    <span class="settings-val monospace" style="word-break:break-all; font-size:0.75rem;">@DataService.DataDirectory</span>
                </div>

                @* QDM Watch Path — editable *@
                <div class="settings-row settings-row--wrap settings-row--editable">
                    <span class="settings-key">QDM Watch Dir</span>
                    @if (_editingQdmPath)
                    {
                        <div style="flex:1; display:flex; flex-direction:column; gap:6px;">
                            <MudTextField @bind-Value="_qdmWatchDirectory"
                                          Placeholder="(not configured)"
                                          Variant="Variant.Outlined" Margin="Margin.Dense"
                                          Style="font-size:0.8rem;" />
                            <MudStack Row="true" Spacing="1">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                           Size="MudBlazor.Size.Small" OnClick="SaveQdmWatchDirectory">Save</MudButton>
                                <MudButton Variant="Variant.Text" Size="MudBlazor.Size.Small"
                                           OnClick="CancelEditQdmPath">Cancel</MudButton>
                            </MudStack>
                        </div>
                    }
                    else
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Style="flex:1;">
                            <span class="settings-val monospace" style="flex:1; font-size:0.75rem; word-break:break-all;">
                                @(string.IsNullOrEmpty(_qdmWatchDirectory) ? "(not configured)" : _qdmWatchDirectory)
                            </span>
                            <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="MudBlazor.Size.Small"
                                           Style="opacity:0.4; padding:2px;" OnClick="EditQdmPath" />
                        </MudStack>
                    }
                </div>

                @* QDM Timezone — editable *@
                <div class="settings-row settings-row--wrap settings-row--editable">
                    <span class="settings-key">QDM Timezone</span>
                    @if (_editingQdmTimezone)
                    {
                        <div style="flex:1; display:flex; flex-direction:column; gap:6px;">
                            <MudSelect T="string" @bind-Value="_qdmTimezoneId"
                                       Variant="Variant.Outlined" Margin="Margin.Dense">
                                <MudSelectItem Value="@("UTC")">UTC (recommended)</MudSelectItem>
                                <MudSelectItem Value="@("Europe/London")">Europe/London (GMT/BST)</MudSelectItem>
                                <MudSelectItem Value="@("America/New_York")">America/New_York (EST/EDT)</MudSelectItem>
                                <MudSelectItem Value="@("America/Chicago")">America/Chicago (CST/CDT)</MudSelectItem>
                                <MudSelectItem Value="@("Asia/Tokyo")">Asia/Tokyo (JST)</MudSelectItem>
                                <MudSelectItem Value="@("Asia/Singapore")">Asia/Singapore (SGT)</MudSelectItem>
                                <MudSelectItem Value="@("Europe/Berlin")">Europe/Berlin (CET/CEST)</MudSelectItem>
                            </MudSelect>
                            <MudStack Row="true" Spacing="1">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                           Size="MudBlazor.Size.Small" OnClick="SaveQdmTimezone">Save</MudButton>
                                <MudButton Variant="Variant.Text" Size="MudBlazor.Size.Small"
                                           OnClick="CancelEditQdmTimezone">Cancel</MudButton>
                            </MudStack>
                        </div>
                    }
                    else
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Style="flex:1;">
                            <span class="settings-val monospace" style="flex:1;">@(_qdmTimezoneId ?? "UTC")</span>
                            <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="MudBlazor.Size.Small"
                                           Style="opacity:0.4; padding:2px;"
                                           OnClick="@(() => _editingQdmTimezone = true)" />
                        </MudStack>
                    }
                </div>
            </div>
        </MudPaper>

        @* Registered Strategies *@
        <MudPaper Class="pa-4" Elevation="1" Style="border-radius:var(--tre-radius);">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Outlined.Psychology" Style="color:var(--mud-palette-success); font-size:1.1rem;" />
                <MudText Typo="Typo.subtitle2">Registered Strategies</MudText>
                <MudChip T="string" Size="MudBlazor.Size.Small" Variant="Variant.Outlined"
                         Style="height:18px; font-size:0.65rem;">@Registry.KnownNames.Count()</MudChip>
            </MudStack>
            <div style="display:flex; flex-wrap:wrap; gap:6px;">
                @foreach (var name in Registry.KnownNames)
                {
                    <MudChip T="string" Size="MudBlazor.Size.Small" Variant="Variant.Outlined"
                             Icon="@Icons.Material.Outlined.Code">@name</MudChip>
                }
            </div>
        </MudPaper>

    </MudItem>

    @* ── About ── *@
    <MudItem xs="12">
        <MudPaper Class="pa-4" Elevation="1" Style="border-radius:var(--tre-radius);">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Outlined.Info" Style="font-size:1.1rem; opacity:0.5;" />
                <MudText Typo="Typo.subtitle2">About</MudText>
            </MudStack>
            <MudStack Row="true" Spacing="4" Wrap="Wrap.Wrap">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.caption" Class="text-faint">Version</MudText>
                    <MudText Typo="Typo.body2" Class="monospace">4.0.0</MudText>
                </MudStack>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.caption" Class="text-faint">Build Date</MudText>
                    <MudText Typo="Typo.body2" Class="monospace">@DateTime.Now.ToString("yyyy-MM-dd")</MudText>
                </MudStack>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.caption" Class="text-faint">Runtime</MudText>
                    <MudText Typo="Typo.body2" Class="monospace">.NET @Environment.Version</MudText>
                </MudStack>
            </MudStack>
        </MudPaper>
    </MudItem>

</MudGrid>

<style>
    .settings-table { display: flex; flex-direction: column; gap: 2px; }

    .settings-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 7px 10px;
        border-radius: 4px;
        background: rgba(255,255,255,0.03);
        gap: 12px;
    }

    .settings-row--wrap { align-items: flex-start; }
    .settings-row--editable { flex-direction: column; align-items: stretch; }

    .settings-key {
        font-size: 0.78rem;
        opacity: 0.55;
        flex-shrink: 0;
        min-width: 130px;
    }

    .settings-val {
        font-size: 0.82rem;
        font-weight: 500;
        text-align: right;
    }
</style>

@code {
#nullable enable
    private string? _qdmWatchDirectory;
    private bool _editingQdmPath;
    private string _qdmTimezoneId = "UTC";
    private bool _editingQdmTimezone;

    protected override void OnInitialized()
    {
        var settings = SettingsService.Load();
        _qdmWatchDirectory = settings.QdmWatchDirectory;
        _qdmTimezoneId     = settings.QdmTimezoneId ?? "UTC";
    }

    private void EditQdmPath() => _editingQdmPath = true;

    private void CancelEditQdmPath()
    {
        _qdmWatchDirectory = SettingsService.Load().QdmWatchDirectory;
        _editingQdmPath = false;
    }

    private void SaveQdmWatchDirectory()
    {
        var updated = SettingsService.Load() with
        {
            QdmWatchDirectory = string.IsNullOrWhiteSpace(_qdmWatchDirectory) ? null : _qdmWatchDirectory.Trim()
        };
        SettingsService.Save(updated);
        _qdmWatchDirectory = updated.QdmWatchDirectory;
        _editingQdmPath = false;
    }

    private void CancelEditQdmTimezone()
    {
        _qdmTimezoneId = SettingsService.Load().QdmTimezoneId ?? "UTC";
        _editingQdmTimezone = false;
    }

    private void SaveQdmTimezone()
    {
        var updated = SettingsService.Load() with { QdmTimezoneId = _qdmTimezoneId };
        SettingsService.Save(updated);
        _editingQdmTimezone = false;
    }
}
