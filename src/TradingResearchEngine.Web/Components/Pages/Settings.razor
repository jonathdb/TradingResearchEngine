@page "/settings"
@using TradingResearchEngine.Core.Configuration
@inject TradingResearchEngine.Infrastructure.Settings.SettingsService SettingsService
@inject ISnackbar Snackbar

<PageTitle>Settings — Research Engine</PageTitle>

<div class="page-header">
    <div class="page-header__title">
        <MudText Typo="Typo.h5">Settings</MudText>
        <MudText Typo="Typo.caption" Class="text-muted">
            Configure your research engine defaults — changes are saved immediately to disk
        </MudText>
    </div>
</div>

<MudGrid Spacing="3">

    @* ── Left Column ── *@
    <MudItem xs="12" md="6">

        @* Risk Defaults *@
        <MudPaper Class="pa-4 mb-3" Elevation="1" Style="border-radius:var(--tre-radius);">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Outlined.Shield" Style="color:var(--mud-palette-warning); font-size:1.1rem;" />
                <MudText Typo="Typo.subtitle2">Risk Defaults</MudText>
            </MudStack>
            <div class="settings-table">
                <div class="settings-row settings-row--field">
                    <span class="settings-key">Max Exposure %</span>
                    <MudNumericField T="decimal" @bind-Value="_maxExposurePercent"
                                     Min="0.1m" Max="100m" Step="0.5m"
                                     Variant="Variant.Outlined" Margin="Margin.Dense"
                                     Class="settings-input" HideSpinButtons="false"
                                     Adornment="Adornment.End" AdornmentText="%" />
                </div>
            </div>
            <div class="settings-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           Size="MudBlazor.Size.Small" StartIcon="@Icons.Material.Outlined.Save"
                           OnClick="SaveRisk">Save</MudButton>
            </div>
        </MudPaper>

        @* Monte Carlo *@
        <MudPaper Class="pa-4 mb-3" Elevation="1" Style="border-radius:var(--tre-radius);">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Outlined.Casino" Style="color:var(--mud-palette-primary); font-size:1.1rem;" />
                <MudText Typo="Typo.subtitle2">Monte Carlo Defaults</MudText>
            </MudStack>
            <div class="settings-table">
                <div class="settings-row settings-row--field">
                    <span class="settings-key">Simulation Count</span>
                    <MudNumericField T="int" @bind-Value="_mcSimCount"
                                     Min="100" Max="100000" Step="100"
                                     Variant="Variant.Outlined" Margin="Margin.Dense"
                                     Class="settings-input" HideSpinButtons="false" />
                </div>
                <div class="settings-row settings-row--field">
                    <span class="settings-key">Ruin Threshold</span>
                    <MudNumericField T="decimal" @bind-Value="_mcRuinThreshold"
                                     Min="0.01m" Max="1m" Step="0.05m"
                                     Format="P0"
                                     Variant="Variant.Outlined" Margin="Margin.Dense"
                                     Class="settings-input" HideSpinButtons="false"
                                     Adornment="Adornment.End" AdornmentText="%" />
                </div>
                <div class="settings-row settings-row--field">
                    <span class="settings-key">Block Size</span>
                    <MudNumericField T="int" @bind-Value="_mcBlockSize"
                                     Min="1" Max="500" Step="1"
                                     Variant="Variant.Outlined" Margin="Margin.Dense"
                                     Class="settings-input" HideSpinButtons="false"
                                     HelperText="1 = IID bootstrap" />
                </div>
                <div class="settings-row settings-row--field">
                    <span class="settings-key">Random Seed</span>
                    <MudTextField @bind-Value="_mcSeedText"
                                  Placeholder="(random)"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Class="settings-input"
                                  HelperText="Leave blank for random" />
                </div>
            </div>
            <div class="settings-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           Size="MudBlazor.Size.Small" StartIcon="@Icons.Material.Outlined.Save"
                           OnClick="SaveMonteCarlo">Save</MudButton>
            </div>
        </MudPaper>

        @* Parameter Sweep *@
        <MudPaper Class="pa-4 mb-3" Elevation="1" Style="border-radius:var(--tre-radius);">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Outlined.GridOn" Style="color:var(--mud-palette-secondary); font-size:1.1rem;" />
                <MudText Typo="Typo.subtitle2">Parameter Sweep</MudText>
            </MudStack>
            <div class="settings-table">
                <div class="settings-row settings-row--field">
                    <span class="settings-key">Max Parallelism</span>
                    <MudNumericField T="int" @bind-Value="_sweepParallelism"
                                     Min="0" Max="64" Step="1"
                                     Variant="Variant.Outlined" Margin="Margin.Dense"
                                     Class="settings-input" HideSpinButtons="false"
                                     HelperText="@($"0 = auto ({Environment.ProcessorCount} cores)")" />
                </div>
            </div>
            <div class="settings-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           Size="MudBlazor.Size.Small" StartIcon="@Icons.Material.Outlined.Save"
                           OnClick="SaveSweep">Save</MudButton>
            </div>
        </MudPaper>

        @* Reporting *@
        <MudPaper Class="pa-4" Elevation="1" Style="border-radius:var(--tre-radius);">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Outlined.Assessment" Style="color:var(--mud-palette-info); font-size:1.1rem;" />
                <MudText Typo="Typo.subtitle2">Reporting</MudText>
            </MudStack>
            <div class="settings-table">
                <div class="settings-row settings-row--field">
                    <span class="settings-key">Decimal Places</span>
                    <MudNumericField T="int" @bind-Value="_reportingDecimals"
                                     Min="0" Max="8" Step="1"
                                     Variant="Variant.Outlined" Margin="Margin.Dense"
                                     Class="settings-input" HideSpinButtons="false" />
                </div>
            </div>
            <div class="settings-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           Size="MudBlazor.Size.Small" StartIcon="@Icons.Material.Outlined.Save"
                           OnClick="SaveReporting">Save</MudButton>
            </div>
        </MudPaper>

    </MudItem>

    @* ── Right Column ── *@
    <MudItem xs="12" md="6">

        @* Backtest Defaults *@
        <MudPaper Class="pa-4 mb-3" Elevation="1" Style="border-radius:var(--tre-radius);">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Outlined.PlayCircleOutline" Style="color:var(--mud-palette-success); font-size:1.1rem;" />
                <MudText Typo="Typo.subtitle2">Backtest Defaults</MudText>
            </MudStack>
            <div class="settings-table">
                <div class="settings-row settings-row--field">
                    <span class="settings-key">Initial Cash</span>
                    <MudNumericField T="decimal" @bind-Value="_initialCash"
                                     Min="1000m" Max="100_000_000m" Step="10000m"
                                     Variant="Variant.Outlined" Margin="Margin.Dense"
                                     Class="settings-input" HideSpinButtons="false"
                                     Adornment="Adornment.Start" AdornmentText="$" />
                </div>
                <div class="settings-row settings-row--field">
                    <span class="settings-key">Risk-Free Rate</span>
                    <MudNumericField T="decimal" @bind-Value="_riskFreeRatePct"
                                     Min="0m" Max="20m" Step="0.1m"
                                     Variant="Variant.Outlined" Margin="Margin.Dense"
                                     Class="settings-input" HideSpinButtons="false"
                                     Adornment="Adornment.End" AdornmentText="%" />
                </div>
                <div class="settings-row settings-row--field">
                    <span class="settings-key">Realism Profile</span>
                    <MudSelect T="ExecutionRealismProfile" @bind-Value="_realismProfile"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               Class="settings-input">
                        <MudSelectItem Value="ExecutionRealismProfile.FastResearch">Fast Research</MudSelectItem>
                        <MudSelectItem Value="ExecutionRealismProfile.StandardBacktest">Standard Backtest</MudSelectItem>
                        <MudSelectItem Value="ExecutionRealismProfile.BrokerConservative">Broker Conservative</MudSelectItem>
                    </MudSelect>
                </div>
                <div class="settings-row settings-row--field">
                    <span class="settings-key">Sizing Policy</span>
                    <MudSelect T="string" @bind-Value="_sizingPolicy"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               Class="settings-input">
                        <MudSelectItem Value="@("PercentEquity")">Percent of Equity</MudSelectItem>
                        <MudSelectItem Value="@("FixedFractional")">Fixed Fractional</MudSelectItem>
                        <MudSelectItem Value="@("FixedSize")">Fixed Size</MudSelectItem>
                    </MudSelect>
                </div>
            </div>
            <div class="settings-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           Size="MudBlazor.Size.Small" StartIcon="@Icons.Material.Outlined.Save"
                           OnClick="SaveBacktestDefaults">Save</MudButton>
            </div>
        </MudPaper>

        @* Storage & Paths *@
        <MudPaper Class="pa-4 mb-3" Elevation="1" Style="border-radius:var(--tre-radius);">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Outlined.Storage" Style="color:var(--mud-palette-primary); font-size:1.1rem;" />
                <MudText Typo="Typo.subtitle2">Storage &amp; Paths</MudText>
            </MudStack>
            <div class="settings-table">
                <div class="settings-row settings-row--field">
                    <span class="settings-key">Data Directory</span>
                    <MudTextField @bind-Value="_dataDirectory"
                                  Placeholder="data"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Class="settings-input monospace"
                                  HelperText="Relative to app root" />
                </div>
                <div class="settings-row settings-row--field">
                    <span class="settings-key">Export Directory</span>
                    <MudTextField @bind-Value="_exportDirectory"
                                  Placeholder="exports"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Class="settings-input monospace"
                                  HelperText="Relative to app root" />
                </div>
                <div class="settings-row settings-row--field">
                    <span class="settings-key">QDM Watch Dir</span>
                    <MudTextField @bind-Value="_qdmWatchDirectory"
                                  Placeholder="(not configured)"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Class="settings-input monospace"
                                  HelperText="Full path to QDM output folder" />
                </div>
                <div class="settings-row settings-row--field">
                    <span class="settings-key">QDM Timezone</span>
                    <MudSelect T="string" @bind-Value="_qdmTimezoneId"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               Class="settings-input">
                        <MudSelectItem Value="@("UTC")">UTC (recommended)</MudSelectItem>
                        <MudSelectItem Value="@("Europe/London")">Europe/London (GMT/BST)</MudSelectItem>
                        <MudSelectItem Value="@("America/New_York")">America/New_York (EST/EDT)</MudSelectItem>
                        <MudSelectItem Value="@("America/Chicago")">America/Chicago (CST/CDT)</MudSelectItem>
                        <MudSelectItem Value="@("Asia/Tokyo")">Asia/Tokyo (JST)</MudSelectItem>
                        <MudSelectItem Value="@("Asia/Singapore")">Asia/Singapore (SGT)</MudSelectItem>
                        <MudSelectItem Value="@("Europe/Berlin")">Europe/Berlin (CET/CEST)</MudSelectItem>
                    </MudSelect>
                </div>
            </div>
            <div class="settings-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           Size="MudBlazor.Size.Small" StartIcon="@Icons.Material.Outlined.Save"
                           OnClick="SaveStorage">Save</MudButton>
            </div>
        </MudPaper>

        @* About *@
        <MudPaper Class="pa-4" Elevation="1" Style="border-radius:var(--tre-radius);">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Outlined.Info" Style="font-size:1.1rem; opacity:0.5;" />
                <MudText Typo="Typo.subtitle2">About</MudText>
            </MudStack>
            <MudStack Row="true" Spacing="4" Wrap="Wrap.Wrap">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.caption" Class="text-faint">Version</MudText>
                    <MudText Typo="Typo.body2" Class="monospace">4.0.0</MudText>
                </MudStack>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.caption" Class="text-faint">Build Date</MudText>
                    <MudText Typo="Typo.body2" Class="monospace">@DateTime.Now.ToString("yyyy-MM-dd")</MudText>
                </MudStack>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.caption" Class="text-faint">Runtime</MudText>
                    <MudText Typo="Typo.body2" Class="monospace">.NET @Environment.Version</MudText>
                </MudStack>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.caption" Class="text-faint">CPU Cores</MudText>
                    <MudText Typo="Typo.body2" Class="monospace">@Environment.ProcessorCount</MudText>
                </MudStack>
            </MudStack>
        </MudPaper>

    </MudItem>

</MudGrid>

<style>
    .settings-table { display: flex; flex-direction: column; gap: 10px; }

    .settings-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .settings-row--field {
        align-items: flex-start;
        flex-direction: column;
        gap: 4px;
    }

    .settings-key {
        font-size: 0.78rem;
        opacity: 0.55;
        padding-top: 2px;
    }

    .settings-input {
        width: 100%;
    }

    .settings-actions {
        display: flex;
        justify-content: flex-end;
        margin-top: 16px;
        padding-top: 12px;
        border-top: 1px solid rgba(255,255,255,0.06);
    }
</style>

@code {
#nullable enable
    private decimal _maxExposurePercent;
    private int _mcSimCount;
    private decimal _mcRuinThreshold;
    private int _mcBlockSize;
    private string _mcSeedText = "";
    private int _sweepParallelism;
    private int _reportingDecimals;
    private string _dataDirectory = "";
    private string _exportDirectory = "";
    private string? _qdmWatchDirectory;
    private string _qdmTimezoneId = "UTC";
    private decimal _initialCash;
    private decimal _riskFreeRatePct;
    private string _sizingPolicy = "PercentEquity";
    private ExecutionRealismProfile _realismProfile;

    protected override void OnInitialized() => LoadFromSettings();

    private void LoadFromSettings()
    {
        var s = SettingsService.Load();
        _maxExposurePercent  = s.MaxExposurePercent;
        _mcSimCount          = s.MonteCarloSimulationCount;
        _mcRuinThreshold     = s.MonteCarloRuinThreshold;
        _mcBlockSize         = s.MonteCarloBlockSize;
        _mcSeedText          = s.MonteCarloSeed?.ToString() ?? "";
        _sweepParallelism    = s.SweepMaxParallelism;
        _reportingDecimals   = s.ReportingDecimalPlaces;
        _dataDirectory       = s.DataDirectory;
        _exportDirectory     = s.ExportDirectory;
        _qdmWatchDirectory   = s.QdmWatchDirectory;
        _qdmTimezoneId       = s.QdmTimezoneId ?? "UTC";
        _initialCash         = s.DefaultInitialCash;
        _riskFreeRatePct     = s.DefaultRiskFreeRate * 100m;
        _sizingPolicy        = s.DefaultSizingPolicy;
        _realismProfile      = s.DefaultRealismProfile;
    }

    private void SaveRisk()
    {
        var s = SettingsService.Load() with { MaxExposurePercent = _maxExposurePercent };
        SettingsService.Save(s);
        Snackbar.Add("Risk defaults saved", Severity.Success);
    }

    private void SaveMonteCarlo()
    {
        int? seed = int.TryParse(_mcSeedText?.Trim(), out var parsed) ? parsed : null;
        var s = SettingsService.Load() with
        {
            MonteCarloSimulationCount = _mcSimCount,
            MonteCarloRuinThreshold   = _mcRuinThreshold,
            MonteCarloBlockSize       = _mcBlockSize,
            MonteCarloSeed            = seed,
        };
        SettingsService.Save(s);
        Snackbar.Add("Monte Carlo defaults saved", Severity.Success);
    }

    private void SaveSweep()
    {
        var s = SettingsService.Load() with { SweepMaxParallelism = _sweepParallelism };
        SettingsService.Save(s);
        Snackbar.Add("Parameter sweep settings saved", Severity.Success);
    }

    private void SaveReporting()
    {
        var s = SettingsService.Load() with { ReportingDecimalPlaces = _reportingDecimals };
        SettingsService.Save(s);
        Snackbar.Add("Reporting settings saved", Severity.Success);
    }

    private void SaveBacktestDefaults()
    {
        var s = SettingsService.Load() with
        {
            DefaultInitialCash    = _initialCash,
            DefaultRiskFreeRate   = _riskFreeRatePct / 100m,
            DefaultSizingPolicy   = _sizingPolicy,
            DefaultRealismProfile = _realismProfile,
        };
        SettingsService.Save(s);
        Snackbar.Add("Backtest defaults saved", Severity.Success);
    }

    private void SaveStorage()
    {
        var s = SettingsService.Load() with
        {
            DataDirectory      = string.IsNullOrWhiteSpace(_dataDirectory)    ? "data"    : _dataDirectory.Trim(),
            ExportDirectory    = string.IsNullOrWhiteSpace(_exportDirectory)  ? "exports" : _exportDirectory.Trim(),
            QdmWatchDirectory  = string.IsNullOrWhiteSpace(_qdmWatchDirectory) ? null     : _qdmWatchDirectory.Trim(),
            QdmTimezoneId      = _qdmTimezoneId,
        };
        SettingsService.Save(s);
        Snackbar.Add("Storage paths saved", Severity.Success);
    }
}
