@page "/job-status/{JobId}"
@using TradingResearchEngine.Application.Research
@inject JobExecutor JobExecutor
@inject NavigationManager Nav
@implements IAsyncDisposable

<PageTitle>Job Status</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-6">
    @if (_job is null && _status is null)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else
    {
        <MudPaper Class="pa-6" Elevation="2">
            <MudStack Spacing="3">
                <MudText Typo="Typo.h5">Backtest Job</MudText>
                <MudText Typo="Typo.caption" Class="text-muted">@JobId</MudText>

                @if (_status is not null)
                {
                    <MudChip T="string" Color="@GetStatusColor(_status.Value)" Size="MudBlazor.Size.Small">
                        @_status.Value.ToString()
                    </MudChip>
                }

                @if (_status is JobStatus.Running or JobStatus.Queued)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Rounded="true" Size="MudBlazor.Size.Large" />
                }

                @if (_status == JobStatus.Failed)
                {
                    <MudAlert Severity="Severity.Error" Class="mt-2">
                        @(_errorMessage ?? "An unexpected error occurred during execution.")
                    </MudAlert>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Edit"
                               Href="/builder">
                        Edit &amp; Retry
                    </MudButton>
                }

                @if (_status == JobStatus.Completed && _completedCountdown > 0)
                {
                    <MudAlert Severity="Severity.Success">
                        Backtest completed. Redirecting in @_completedCountdown second(s)...
                    </MudAlert>
                }
            </MudStack>
        </MudPaper>
    }
</MudContainer>

@code {
    [Parameter] public string JobId { get; set; } = "";

    private BacktestJob? _job;
    private JobStatus? _status;
    private string? _errorMessage;
    private PeriodicTimer? _timer;
    private CancellationTokenSource _cts = new();
    private int _completedCountdown;
    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        _status = await JobExecutor.GetStatusAsync(JobId, _cts.Token);
        _job = await JobExecutor.GetJobAsync(JobId, _cts.Token);
        if (_status == JobStatus.Failed)
        {
            _errorMessage = await JobExecutor.GetErrorAsync(JobId, _cts.Token);
        }
        _ = PollStatusAsync();
    }

    private async Task PollStatusAsync()
    {
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try
        {
            while (await _timer.WaitForNextTickAsync(_cts.Token))
            {
                if (_disposed) break;

                _status = await JobExecutor.GetStatusAsync(JobId, _cts.Token);
                if (!_disposed) await InvokeAsync(StateHasChanged);

                if (_status == JobStatus.Completed)
                {
                    _completedCountdown = 1;
                    if (!_disposed) await InvokeAsync(StateHasChanged);
                    await Task.Delay(1000, _cts.Token);
                    if (_disposed) break;
                    var resultId = await JobExecutor.GetResultIdAsync(JobId, _cts.Token);
                    if (resultId is not null && !_disposed)
                    {
                        Nav.NavigateTo($"/runs/{resultId}");
                    }
                    break;
                }

                if (_status == JobStatus.Failed)
                {
                    _errorMessage = await JobExecutor.GetErrorAsync(JobId, _cts.Token);
                    if (!_disposed) await InvokeAsync(StateHasChanged);
                    break;
                }

                if (_status == JobStatus.Cancelled)
                {
                    break;
                }
            }
        }
        catch (OperationCanceledException) { }
    }

    private static Color GetStatusColor(JobStatus status) => status switch
    {
        JobStatus.Queued => Color.Default,
        JobStatus.Running => Color.Info,
        JobStatus.Completed => Color.Success,
        JobStatus.Failed => Color.Error,
        JobStatus.Cancelled => Color.Warning,
        _ => Color.Default
    };

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await _cts.CancelAsync();
        _cts.Dispose();
        _timer?.Dispose();
    }
}
