@page "/market-data"
@using TradingResearchEngine.Application.MarketData
@using TradingResearchEngine.Application.TickImport
@inject TickImportService TickImportSvc
@inject ITickImportRepository TickImportRepo
@inject MarketDataImportService ImportService
@inject TradingResearchEngine.Application.MarketData.IMarketDataImportRepository ImportRepo
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>Market Data — Research Engine</PageTitle>

<div class="page-header">
    <div class="page-header__title">
        <MudText Typo="Typo.h5">Market Data</MudText>
        <MudText Typo="Typo.caption" Class="text-muted">Import tick and OHLCV data from providers, or manage existing datasets</MudText>
    </div>
</div>

@* Tick Import Form *@
<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.subtitle2" Class="text-muted mb-3">IMPORT TICK DATA FROM PROVIDER</MudText>
    <MudGrid>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="string" @bind-Value="_source" Label="Source" Variant="Variant.Outlined"
                       Disabled="@(_isTickImportRunning)">
                <MudSelectItem Value="@("Dukascopy")">Dukascopy</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="string" @bind-Value="_symbol" Label="Symbol" Variant="Variant.Outlined"
                       Disabled="@(_isTickImportRunning)">
                @foreach (var sym in _symbols)
                {
                    <MudSelectItem Value="@sym.Symbol">@sym.Symbol — @sym.DisplayName</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="6" sm="3" md="3">
            <MudDatePicker @bind-Date="_startDate" Label="Start" Variant="Variant.Outlined"
                           Disabled="@(_isTickImportRunning)" />
        </MudItem>
        <MudItem xs="6" sm="3" md="3">
            <MudDatePicker @bind-Date="_endDate" Label="End" Variant="Variant.Outlined"
                           Disabled="@(_isTickImportRunning)" />
        </MudItem>
    </MudGrid>

    <MudStack Row="true" Spacing="1" Class="mt-2 mb-3">
        <MudText Typo="Typo.caption" Class="text-muted mr-2 align-self-center">Quick:</MudText>
        <MudButton Size="MudBlazor.Size.Small" Variant="Variant.Text" OnClick="@(() => SetPreset(1))" Disabled="@(_isTickImportRunning)">1Y</MudButton>
        <MudButton Size="MudBlazor.Size.Small" Variant="Variant.Text" OnClick="@(() => SetPreset(3))" Disabled="@(_isTickImportRunning)">3Y</MudButton>
        <MudButton Size="MudBlazor.Size.Small" Variant="Variant.Text" OnClick="@(() => SetPreset(5))" Disabled="@(_isTickImportRunning)">5Y</MudButton>
        <MudButton Size="MudBlazor.Size.Small" Variant="Variant.Text" OnClick="@(() => SetPreset(10))" Disabled="@(_isTickImportRunning)">10Y</MudButton>
    </MudStack>

    @if (_validationErrors.Count > 0)
    {
        @foreach (var err in _validationErrors)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-1">@err</MudAlert>
        }
    }

    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.CloudDownload"
               OnClick="StartTickDownload" Disabled="@(_isTickImportRunning)">
        Start Download
    </MudButton>
</MudPaper>

@* Tick Import History *@
<MudText Typo="Typo.subtitle2" Class="text-muted mb-2">TICK IMPORTS</MudText>

@if (_tickImports.Count == 0 && !_isTickImportRunning)
{
    <MudAlert Severity="Severity.Info">No tick imports yet. Configure a download above to get started.</MudAlert>
}
else
{
    @* Show active import with progress *@
    @if (_isTickImportRunning && _activeTickImport is not null)
    {
        <MudPaper Outlined="true" Class="pa-3 mb-2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                <MudChip T="string" Size="MudBlazor.Size.Small" Color="Color.Info">🔄 Running</MudChip>
                <MudText Typo="Typo.body2">@_activeTickImport.Symbol</MudText>
                @if (_tickProgress is not null)
                {
                    <MudText Typo="Typo.caption" Class="text-muted">@_tickProgress.Label</MudText>
                    <MudProgressLinear Value="@(_tickProgress.Total > 0 ? (double)_tickProgress.Current / _tickProgress.Total * 100 : 0)"
                                       Style="width: 160px" />
                }
                <MudSpacer />
                <MudButton Size="MudBlazor.Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                           OnClick="@(() => CancelTickImport(_activeTickImport.ImportId))">Cancel</MudButton>
            </MudStack>
        </MudPaper>
    }

    @* Completed/Failed/Cancelled imports *@
    @foreach (var imp in _tickImports)
    {
        <MudPaper Outlined="true" Class="pa-3 mb-2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                @{
                    var (icon, color) = imp.Status switch
                    {
                        TickImportStatus.Completed => ("✅", Color.Success),
                        TickImportStatus.Running => ("🔄", Color.Info),
                        TickImportStatus.Failed => ("❌", Color.Error),
                        TickImportStatus.Cancelled => ("⚠️", Color.Warning),
                        _ => ("", Color.Default)
                    };
                }
                <MudChip T="string" Size="MudBlazor.Size.Small" Color="@color">@icon @imp.Status</MudChip>
                <MudText Typo="Typo.body2">@imp.Symbol</MudText>
                <MudText Typo="Typo.caption" Class="text-muted">
                    @imp.RequestedStart.ToString("yyyy-MM-dd") → @imp.RequestedEnd.ToString("yyyy-MM-dd")
                    · @imp.Source
                    @if (imp.TotalTickCount.HasValue)
                    {
                        <text> · @imp.TotalTickCount.Value.ToString("N0") ticks</text>
                    }
                </MudText>
                <MudSpacer />

                @if (imp.Status == TickImportStatus.Completed)
                {
                    <MudButton Size="MudBlazor.Size.Small" Variant="Variant.Text"
                               Href="@($"/market-data/import/{imp.ImportId}")">View Details</MudButton>
                }
                else if (imp.Status == TickImportStatus.Failed)
                {
                    <MudButton Size="MudBlazor.Size.Small" Variant="Variant.Text"
                               OnClick="@(() => ReimportTick(imp))">Retry</MudButton>
                }
                else if (imp.Status == TickImportStatus.Cancelled)
                {
                    <MudButton Size="MudBlazor.Size.Small" Variant="Variant.Text"
                               OnClick="@(() => ReimportTick(imp))">Retry</MudButton>
                }
            </MudStack>

            @if (imp.Status == TickImportStatus.Failed && imp.ErrorDetail is not null)
            {
                <MudExpansionPanels Class="mt-2">
                    <MudExpansionPanel Text="Error Details" Dense="true" Expanded="false">
                        <MudText Typo="Typo.caption" Style="font-family: monospace; white-space: pre-wrap">@imp.ErrorDetail</MudText>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }
        </MudPaper>
    }
}

@* Legacy Import History (existing candle imports) *@
@if (_legacyImports.Count > 0)
{
    <MudText Typo="Typo.subtitle2" Class="text-muted mb-2 mt-4">LEGACY CANDLE IMPORTS</MudText>
    @foreach (var imp in _legacyImports)
    {
        <MudPaper Outlined="true" Class="pa-3 mb-2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                @{
                    var (legIcon, legColor) = imp.Status switch
                    {
                        MarketDataImportStatus.Completed => ("✅", Color.Success),
                        MarketDataImportStatus.Running => ("🔄", Color.Info),
                        MarketDataImportStatus.Failed => ("❌", Color.Error),
                        MarketDataImportStatus.Cancelled => ("⚠️", Color.Warning),
                        _ => ("", Color.Default)
                    };
                }
                <MudChip T="string" Size="MudBlazor.Size.Small" Color="@legColor">@legIcon @imp.Status</MudChip>
                <MudText Typo="Typo.body2">@imp.Symbol @imp.Timeframe</MudText>
                <MudText Typo="Typo.caption" Class="text-muted">
                    @imp.RequestedStart.ToString("yyyy-MM-dd") → @imp.RequestedEnd.ToString("yyyy-MM-dd")
                    · @imp.Source
                </MudText>
                <MudSpacer />
                @if (imp.Status == MarketDataImportStatus.Completed && imp.OutputFilePath is not null)
                {
                    <MudText Typo="Typo.caption" Class="text-muted">@Path.GetFileName(imp.OutputFilePath)</MudText>
                    <MudButton Size="MudBlazor.Size.Small" Variant="Variant.Text" Href="/data">View in Data Files</MudButton>
                }
            </MudStack>
        </MudPaper>
    }
}

@code {
    private string _source = "Dukascopy";
    private string _symbol = "EURUSD";
    private DateTime? _startDate = DateTime.Today.AddYears(-3);
    private DateTime? _endDate = DateTime.Today;
    private List<string> _validationErrors = new();
    private bool _isTickImportRunning;
    private TickImportProgressUpdate? _tickProgress;
    private ActiveTickImport? _activeTickImport;

    private IReadOnlyList<MarketSymbolInfo> _symbols = Array.Empty<MarketSymbolInfo>();
    private List<TickImportRecord> _tickImports = new();
    private List<MarketDataImportRecord> _legacyImports = new();

    protected override async Task OnInitializedAsync()
    {
        LoadSymbols();
        await LoadTickImports();
        await LoadLegacyImports();

        _activeTickImport = TickImportSvc.GetActiveImport();
        _isTickImportRunning = _activeTickImport is not null;

        TickImportSvc.OnProgress += HandleTickProgress;
        TickImportSvc.OnCompleted += HandleTickCompleted;
    }

    private void LoadSymbols()
    {
        _symbols = new List<MarketSymbolInfo>
        {
            new("EURUSD", "Euro / US Dollar", Array.Empty<string>()),
            new("GBPUSD", "British Pound / US Dollar", Array.Empty<string>()),
            new("USDJPY", "US Dollar / Japanese Yen", Array.Empty<string>()),
            new("USDCHF", "US Dollar / Swiss Franc", Array.Empty<string>()),
            new("AUDUSD", "Australian Dollar / US Dollar", Array.Empty<string>()),
            new("NZDUSD", "New Zealand Dollar / US Dollar", Array.Empty<string>()),
            new("USDCAD", "US Dollar / Canadian Dollar", Array.Empty<string>()),
            new("EURGBP", "Euro / British Pound", Array.Empty<string>()),
            new("EURJPY", "Euro / Japanese Yen", Array.Empty<string>()),
            new("GBPJPY", "British Pound / Japanese Yen", Array.Empty<string>()),
            new("XAUUSD", "Gold / US Dollar", Array.Empty<string>()),
            new("XAGUSD", "Silver / US Dollar", Array.Empty<string>()),
            new("USA500IDXUSD", "S&P 500 Index", Array.Empty<string>()),
            new("USA30IDXUSD", "Dow Jones 30 Index", Array.Empty<string>()),
            new("USATECHIDXUSD", "Nasdaq 100 Index", Array.Empty<string>()),
        };
    }

    private async Task LoadTickImports()
    {
        try
        {
            var all = await TickImportRepo.ListAsync();
            _tickImports = all
                .Where(r => r.Status != TickImportStatus.Running)
                .OrderByDescending(r => r.CreatedAt)
                .ToList();
        }
        catch { _tickImports = new(); }
    }

    private async Task LoadLegacyImports()
    {
        try
        {
            var all = await ImportRepo.ListAsync();
            _legacyImports = all.OrderByDescending(r => r.CreatedAt).ToList();
        }
        catch { _legacyImports = new(); }
    }

    private void SetPreset(int years)
    {
        _endDate = DateTime.Today;
        _startDate = DateTime.Today.AddYears(-years);
    }

    private async Task StartTickDownload()
    {
        _validationErrors.Clear();

        if (_startDate is null || _endDate is null)
        {
            _validationErrors.Add("Start and end dates are required.");
            return;
        }
        if (_startDate >= _endDate)
        {
            _validationErrors.Add("Start date must be before end date.");
            return;
        }
        if (string.IsNullOrWhiteSpace(_symbol))
        {
            _validationErrors.Add("Symbol is required.");
            return;
        }

        var start = new DateTimeOffset(DateTime.SpecifyKind(_startDate.Value.Date, DateTimeKind.Utc), TimeSpan.Zero);
        var end = new DateTimeOffset(DateTime.SpecifyKind(_endDate.Value.Date, DateTimeKind.Utc), TimeSpan.Zero);

        try
        {
            await TickImportSvc.StartTickImportAsync(_symbol, start, end);
            _isTickImportRunning = true;
            _activeTickImport = TickImportSvc.GetActiveImport();
            Snackbar.Add($"Tick import started: {_symbol}", Severity.Success);
        }
        catch (InvalidOperationException ex)
        {
            _validationErrors.Add(ex.Message);
        }
        catch (ArgumentException ex)
        {
            _validationErrors.Add(ex.Message);
        }
    }

    private void CancelTickImport(string importId)
    {
        TickImportSvc.CancelImport(importId);
        Snackbar.Add("Import cancellation requested.", Severity.Warning);
    }

    private void ReimportTick(TickImportRecord imp)
    {
        _source = imp.Source;
        _symbol = imp.Symbol;
        _startDate = imp.RequestedStart.DateTime;
        _endDate = imp.RequestedEnd.DateTime;
        _validationErrors.Clear();
    }

    private void HandleTickProgress(TickImportProgressUpdate update)
    {
        _tickProgress = update;
        InvokeAsync(StateHasChanged);
    }

    private void HandleTickCompleted(TickImportCompletionUpdate update)
    {
        _isTickImportRunning = false;
        _tickProgress = null;
        _activeTickImport = null;
        InvokeAsync(async () =>
        {
            await LoadTickImports();
            StateHasChanged();
            var severity = update.Status == TickImportStatus.Completed ? Severity.Success
                : update.Status == TickImportStatus.Cancelled ? Severity.Warning
                : Severity.Error;
            Snackbar.Add($"Tick import {update.Status}: {update.ErrorMessage ?? "done"}", severity);
        });
    }

    public void Dispose()
    {
        TickImportSvc.OnProgress -= HandleTickProgress;
        TickImportSvc.OnCompleted -= HandleTickCompleted;
    }
}
