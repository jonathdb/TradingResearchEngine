@page "/"
@using TradingResearchEngine.Application.Strategies
@using TradingResearchEngine.Application.Research
@using TradingResearchEngine.Web.Components.Shared
@implements IDisposable
@inject IBacktestResultRepository ResultRepo
@inject IStrategyRepository StrategyRepo
@inject IStudyRepository StudyRepo
@inject IRobustnessAdvisoryService RobustnessService
@inject ResearchChecklistService ChecklistService
@inject NavigationManager Nav

<PageTitle>Dashboard — Research Engine</PageTitle>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        Failed to load dashboard data: @_error
    </MudAlert>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RetryLoad">Retry</MudButton>
}
else if (_loading)
{
    <SkeletonDashboard />
}
else
{
    <MudText Typo="Typo.h4" Class="mb-4">Dashboard</MudText>

    @* Zone 1 — Strategy Status Strip *@
    <MudText Typo="Typo.subtitle2" Class="text-muted mb-2">YOUR STRATEGIES</MudText>
    @if (_strategies.Count == 0)
    {
        <MudPaper Class="pa-8 mb-4 d-flex flex-column align-center justify-center" Elevation="0" Style="text-align:center; border: 1px dashed var(--mud-palette-divider);">
            <MudIcon Icon="@Icons.Material.Outlined.AutoGraph" Style="font-size:3rem;" Class="text-muted mb-3" />
            <MudText Typo="Typo.h6" Class="mb-1">No strategies yet</MudText>
            <MudText Typo="Typo.body2" Class="text-muted mb-4">Create your first strategy to start backtesting and building your research pipeline.</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/strategies/builder"
                       StartIcon="@Icons.Material.Filled.Add">New Strategy</MudButton>
        </MudPaper>
    }
    else
    {
        <div class="strategy-strip-wrapper">
            <div class="strategy-strip">
                @foreach (var s in _strategies)
                {
                    var lastRun = _lastRunMap.GetValueOrDefault((string)s.StrategyType);
                    var checklist = _checklistMap.GetValueOrDefault((string)s.StrategyType);
                    <MudPaper @key="s.StrategyId"
                              Class="@($"pa-3 strategy-strip-card {(lastRun is not null ? "strip-active" : "strip-untested")}")"
                              Elevation="1"
                              role="button"
                              tabindex="0"
                              aria-label="@($"{s.StrategyName} — {(lastRun is not null ? "Active" : "Untested")}")"
                              @onclick="@(() => Nav.NavigateTo($"/strategies/{s.StrategyId}"))"
                              @onkeydown="@(e => { if (e.Key is "Enter" or " ") Nav.NavigateTo($"/strategies/{s.StrategyId}"); })">
                        <MudText Typo="Typo.subtitle2">@s.StrategyName</MudText>
                        <MudText Typo="Typo.body2" Class="@GetSharpeClass(lastRun?.SharpeRatio)">
                            Sharpe: @(lastRun?.SharpeRatio?.ToString("F2") ?? "—")
                        </MudText>
                        @if (checklist is not null)
                        {
                            <MudProgressLinear Value="@((double)checklist.PassedCount / checklist.TotalChecks * 100)"
                                              Color="@GetChecklistColor(checklist)" Size="MudBlazor.Size.Small" Class="my-1" />
                            <MudText Typo="Typo.caption" Class="@GetChecklistClass(checklist)">
                                @checklist.PassedCount/@checklist.TotalChecks checks
                            </MudText>
                        }
                        <MudText Typo="Typo.caption" Class="@GetStageBadgeClass(s.Stage)">@s.Stage</MudText>
                        @if (lastRun?.CreatedAt is { } runDate && runDate != default)
                        {
                            <MudText Typo="Typo.caption" Class="text-faint">@FormatRelativeDate(runDate)</MudText>
                        }
                        @if (checklist?.NextAction is { } nextAction)
                        {
                            <MudTooltip Text="@nextAction.Description">
                                <MudIcon Icon="@(nextAction.IsWarning ? Icons.Material.Filled.Warning : Icons.Material.Filled.PlayArrow)"
                                         Size="MudBlazor.Size.Small"
                                         Color="@(nextAction.IsWarning ? Color.Warning : Color.Info)" />
                            </MudTooltip>
                        }
                    </MudPaper>
                }
                <MudPaper Class="pa-3 d-flex align-center justify-center strategy-strip-card" Elevation="0"
                          role="button" tabindex="0" aria-label="Create new strategy"
                          @onclick="@(() => Nav.NavigateTo("/strategies/builder"))"
                          @onkeydown="@(e => { if (e.Key is "Enter" or " ") Nav.NavigateTo("/strategies/builder"); })">
                    <MudStack AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.Add" Class="text-muted" />
                        <MudText Typo="Typo.caption" Class="text-muted">New Strategy</MudText>
                    </MudStack>
                </MudPaper>
            </div>
        </div>
    }

    @* Zone 2 — KPI Tiles *@
    <MudGrid Class="mb-4">
        <MudItem xs="6" sm="3">
            <MudPaper Class="pa-3 kpi-card" Elevation="1"
                      @onclick="@(() => Nav.NavigateTo("/strategies/library"))">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
                    <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="MudBlazor.Size.Small" Class="text-muted" />
                    <MudText Typo="Typo.caption" Class="text-muted">Strategies</MudText>
                </MudStack>
                <MudText Typo="Typo.h5">@_strategies.Count</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Class="pa-3 kpi-card" Elevation="1"
                      @onclick="@(() => { if (GetLastSharpeNavigationTarget() is { } t) Nav.NavigateTo(t); })">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudStack Spacing="0">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
                            <MudIcon Icon="@Icons.Material.Filled.ShowChart" Size="MudBlazor.Size.Small" Class="text-muted" />
                            <MudText Typo="Typo.caption" Class="text-muted">Last Sharpe</MudText>
                        </MudStack>
                        <MudText Typo="Typo.h5">@(_latestRun?.SharpeRatio?.ToString("F2") ?? "—")</MudText>
                    </MudStack>
                    <KpiSparkline Values="@_recentSharpes" Width="60" Height="24" />
                </MudStack>
                @if (GetLastSharpeStrategyName() is { } stratName)
                {
                    <MudText Typo="Typo.caption" Class="text-muted">@stratName</MudText>
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Class="pa-3 kpi-card" Elevation="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
                    <MudIcon Icon="@Icons.Material.Filled.Science" Size="MudBlazor.Size.Small" Class="text-muted" />
                    <MudText Typo="Typo.caption" Class="text-muted">Active Studies</MudText>
                </MudStack>
                <MudText Typo="Typo.h5">@_activeStudies</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Class="pa-3 kpi-card" Elevation="1"
                      @onclick="@(() => Nav.NavigateTo("/robustness-hub"))">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
                    <MudIcon Icon="@Icons.Material.Filled.Flag"
                             Size="MudBlazor.Size.Small"
                             Color="@(_warningRuns.Count > 0 ? Color.Warning : Color.Default)" />
                    <MudText Typo="Typo.caption" Class="@(_warningRuns.Count > 0 ? "mud-warning-text" : "text-muted")">Flags</MudText>
                </MudStack>
                <MudText Typo="Typo.h5" Color="@(_warningRuns.Count > 0 ? Color.Warning : Color.Default)">@_warningRuns.Count</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @* Zone 3 — Two-column body *@
    <MudGrid>
        <MudItem xs="12" md="8">
            <MudText Typo="Typo.subtitle2" Class="text-muted mb-2">RECENT RUNS</MudText>
            @if (_recentRuns.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true">
                    No runs yet. <MudLink Href="/strategies/builder">Create a strategy</MudLink> and run your first backtest.
                </MudAlert>
            }
            else
            {
                <MudStack Row="true" Spacing="2" Class="mb-2" AlignItems="AlignItems.Center">
                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                        @foreach (var t in _allStrategyTypes)
                        {
                            <MudChip T="string" Size="MudBlazor.Size.Small"
                                     Color="@(_selectedTypeFilter == t ? Color.Primary : Color.Default)"
                                     Variant="@(_selectedTypeFilter == t ? Variant.Filled : Variant.Outlined)"
                                     OnClick="@(() => ToggleTypeFilter(t))">@t</MudChip>
                        }
                    </MudStack>
                    <MudSpacer />
                    <MudSwitch T="bool" Value="_showFailedRuns" ValueChanged="OnShowFailedChanged" Label="Show failed" Color="Color.Warning" />
                </MudStack>

                <MudTable Items="_cachedFilteredRuns" Dense="true" Hover="true" Class="mb-4"
                          SortLabel="Sort By" aria-label="Recent backtest runs">
                    <HeaderContent>
                        <MudTh><MudCheckBox T="bool" Value="_selectAll" ValueChanged="ToggleSelectAll" Size="MudBlazor.Size.Small" /></MudTh>
                        <MudTh>Strategy</MudTh>
                        <MudTh>Date</MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<BacktestResult, object>(x => x.SharpeRatio ?? decimal.MinValue)">Sharpe</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<BacktestResult, object>(x => x.MaxDrawdown)">Max DD</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<BacktestResult, object>(x => x.TotalTrades)">Trades</MudTableSortLabel></MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd @key="context.Id"><MudCheckBox T="bool" Value="_selectedRunIds.Contains(context.Id)" ValueChanged="@((bool v) => ToggleRunSelection(context.Id, v))" Size="MudBlazor.Size.Small" /></MudTd>
                        <MudTd>
                            @if (_strategyIdByType.TryGetValue(context.ScenarioConfig.StrategyType, out var sid))
                            { <MudLink Href="@($"/strategies/{sid}")">@context.ScenarioConfig.StrategyType</MudLink> }
                            else
                            { <MudText Typo="Typo.body2">@context.ScenarioConfig.StrategyType</MudText> }
                        </MudTd>
                        <MudTd><MudText Typo="Typo.body2" Class="text-muted">@FormatRunDate(context)</MudText></MudTd>
                        <MudTd Class="@GetSharpeClass(context.SharpeRatio)">@(context.SharpeRatio?.ToString("F2") ?? "—")</MudTd>
                        <MudTd>@context.MaxDrawdown.ToString("P1")</MudTd>
                        <MudTd>@context.TotalTrades</MudTd>
                        <MudTd><MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="MudBlazor.Size.Small" Href="@($"/backtests/{context.Id}")" aria-label="Open run detail" /></MudTd>
                    </RowTemplate>
                </MudTable>

                @if (_selectedRunIds.Count >= 2)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="MudBlazor.Size.Small"
                               StartIcon="@Icons.Material.Filled.CompareArrows"
                               Disabled="@(_selectedRunIds.Count > 5)"
                               OnClick="NavigateToCompare" Class="mb-2">
                        Compare Selected (@_selectedRunIds.Count)
                    </MudButton>
                }
            }
        </MudItem>
        <MudItem xs="12" md="4">
            <MudText Typo="Typo.subtitle2" Class="text-muted mb-2">⚠ ROBUSTNESS FLAGS</MudText>
            @if (_warningRuns.Count == 0)
            {
                <MudAlert Severity="Severity.Success" Dense="true">All clear — no robustness flags.</MudAlert>
            }
            else
            {
                @foreach (var (run, warnings) in _warningRuns)
                {
                    <MudPaper @key="run.Id" Outlined="true" Class="pa-2 mb-2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
                            @if (_strategyIdByType.TryGetValue(run.ScenarioConfig.StrategyType, out var flagSid))
                            { <MudLink Href="@($"/strategies/{flagSid}")" Typo="Typo.body2">@run.ScenarioConfig.StrategyType</MudLink> }
                            else
                            { <MudText Typo="Typo.body2">@run.ScenarioConfig.StrategyType</MudText> }
                            <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="MudBlazor.Size.Small" Class="text-muted"
                                           Href="@($"/backtests/{run.Id}")" aria-label="View run result" />
                        </MudStack>
                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                            @foreach (var w in warnings)
                            {
                                <MudTooltip Text="@RobustnessWarningCatalog.GetExplanation(w)">
                                    <MudChip T="string" Size="MudBlazor.Size.Small" Color="Color.Warning">@w</MudChip>
                                </MudTooltip>
                            }
                        </MudStack>
                    </MudPaper>
                }
            }
        </MudItem>
    </MudGrid>

    @* Research Pipeline *@
    @if (_stageGroups.Count > 0)
    {
        <MudPaper Outlined="true" Class="pa-3 mt-4 mb-2">
            <MudText Typo="Typo.subtitle2" Class="text-muted mb-2">RESEARCH PIPELINE</MudText>
            <MudStack Row="true" Spacing="3" Wrap="Wrap.Wrap">
                @foreach (var g in _stageGroups)
                {
                    <MudChip T="string" Size="MudBlazor.Size.Small" Class="@GetStageBadgeClass(g.Stage)">@g.Count @g.Stage</MudChip>
                }
            </MudStack>
        </MudPaper>
    }

    @* Suggested Next Steps *@
    @if (_suggestedActions.Count > 0)
    {
        <MudPaper Outlined="true" Class="pa-3 mt-2 mb-4">
            <MudText Typo="Typo.subtitle2" Class="text-muted mb-2">SUGGESTED NEXT STEPS</MudText>
            @foreach (var (strategy, action) in _suggestedActions.Take(3))
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-1">
                    <MudIcon Icon="@(action.IsWarning ? Icons.Material.Filled.Warning : Icons.Material.Filled.ArrowForward)"
                             Size="MudBlazor.Size.Small" Color="@(action.IsWarning ? Color.Warning : Color.Info)" />
                    <MudText Typo="Typo.body2"><strong>@strategy.StrategyName</strong>: @action.ActionLabel</MudText>
                </MudStack>
            }
        </MudPaper>
    }

    @* Zone 4 — Nav cards *@
    <MudGrid Class="mt-4">
        <MudItem xs="12" sm="4">
            <MudPaper Class="pa-3 clickable-card" Elevation="1" @onclick="@(() => Nav.NavigateTo("/research/explorer"))">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Science" Class="text-muted" />
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.subtitle2">Research Explorer</MudText>
                        <MudText Typo="Typo.caption" Class="text-muted">Browse all studies</MudText>
                    </MudStack>
                    <MudSpacer />
                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="MudBlazor.Size.Small" Class="text-faint" />
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Class="pa-3 clickable-card" Elevation="1" @onclick="@(() => Nav.NavigateTo("/propfirm/evaluate"))">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Class="text-muted" />
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.subtitle2">Prop Firm Lab</MudText>
                        <MudText Typo="Typo.caption" Class="text-muted">Evaluate against firm rules</MudText>
                    </MudStack>
                    <MudSpacer />
                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="MudBlazor.Size.Small" Class="text-faint" />
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Class="pa-3 clickable-card" Elevation="1" @onclick="@(() => Nav.NavigateTo("/data"))">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Storage" Class="text-muted" />
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.subtitle2">Data Files</MudText>
                        <MudText Typo="Typo.caption" Class="text-muted">Manage market data</MudText>
                    </MudStack>
                    <MudSpacer />
                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="MudBlazor.Size.Small" Class="text-faint" />
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private readonly CancellationTokenSource _cts = new();

    private List<StrategyIdentity> _strategies = new();
    private List<BacktestResult> _recentRuns = new();
    private List<BacktestResult> _cachedFilteredRuns = new();
    private BacktestResult? _latestRun;
    private int _activeStudies;
    private Dictionary<string, BacktestResult> _lastRunMap = new();
    private Dictionary<string, string> _strategyIdByType = new();
    private Dictionary<string, Application.Research.ResearchChecklist> _checklistMap = new();
    private List<(BacktestResult Run, List<string> Warnings)> _warningRuns = new();
    private List<(int Count, DevelopmentStage Stage)> _stageGroups = new();
    private List<(StrategyIdentity Strategy, NextRecommendedAction Action)> _suggestedActions = new();
    private List<string> _allStrategyTypes = new();
    private List<decimal> _recentSharpes = new();
    private string? _selectedTypeFilter;
    private bool _showFailedRuns;
    private bool _loading = true;
    private string? _error;
    private HashSet<string> _selectedRunIds = new();
    private bool _selectAll;

    protected override async Task OnInitializedAsync() => await LoadDashboardData();

    private async Task LoadDashboardData()
    {
        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
            _strategies = (await StrategyRepo.ListAsync(_cts.Token)).ToList();

            var pagedRuns = await ResultRepo.ListPagedAsync(page: 1, pageSize: 10, ct: _cts.Token);
            _recentRuns = pagedRuns.Items.ToList();
            _latestRun = _recentRuns.FirstOrDefault();

            var studies = (await StudyRepo.ListAsync(_cts.Token)).ToList();
            _activeStudies = studies.Count(s => s.Status == StudyStatus.Running);

            var allRuns = await ResultRepo.ListAsync(_cts.Token);
            _lastRunMap = allRuns
                .OrderByDescending(r => r.RunId)
                .GroupBy(r => r.ScenarioConfig.StrategyType)
                .ToDictionary(g => g.Key, g => g.First());

            _strategyIdByType = _strategies
                .GroupBy(s => (string)s.StrategyType)
                .ToDictionary(g => g.Key, g => g.First().StrategyId);

            foreach (var run in allRuns.Where(r => r.Status == BacktestStatus.Completed).OrderByDescending(r => r.RunId).Take(10))
            {
                var w = RobustnessService.GetWarnings(run);
                if (w.Count > 0) _warningRuns.Add((run, w.ToList()));
            }

            _stageGroups = _strategies
                .GroupBy(s => s.Stage).OrderBy(g => g.Key)
                .Select(g => (Count: g.Count(), Stage: g.Key)).ToList();

            _allStrategyTypes = _recentRuns
                .Select(r => r.ScenarioConfig.StrategyType).Distinct().OrderBy(t => t).ToList();

            _recentSharpes = allRuns
                .Where(r => r.Status == BacktestStatus.Completed && r.SharpeRatio.HasValue)
                .OrderByDescending(r => r.RunId).Take(5)
                .Select(r => r.SharpeRatio!.Value).Reverse().ToList();

            foreach (var strategy in _strategies)
            {
                try
                {
                    var versions = await StrategyRepo.GetVersionsAsync(strategy.StrategyId, _cts.Token);
                    var latestVersion = versions.OrderByDescending(v => v.CreatedAt).FirstOrDefault();
                    if (latestVersion is not null)
                    {
                        var checklist = await ChecklistService.ComputeAsync(latestVersion.StrategyVersionId, _cts.Token);
                        _checklistMap[(string)strategy.StrategyType] = checklist;
                        if (checklist.NextAction is { } action)
                            _suggestedActions.Add((strategy, action));
                    }
                }
                catch (Exception)
                {
                    /* logged below */
                }
            }

            RecomputeFilteredRuns();
            _loading = false;
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            _error = ex.Message;
            _loading = false;
        }
    }

    private async Task RetryLoad()
    {
        _warningRuns.Clear();
        _suggestedActions.Clear();
        await LoadDashboardData();
    }

    public void Dispose() { _cts.Cancel(); _cts.Dispose(); }

    private void RecomputeFilteredRuns()
    {
        _cachedFilteredRuns = _recentRuns
            .Where(r => _showFailedRuns || r.Status != BacktestStatus.Failed)
            .Where(r => _selectedTypeFilter is null || r.ScenarioConfig.StrategyType == _selectedTypeFilter)
            .ToList();
    }

    private void OnShowFailedChanged(bool value) { _showFailedRuns = value; RecomputeFilteredRuns(); }
    private void ToggleTypeFilter(string type) { _selectedTypeFilter = _selectedTypeFilter == type ? null : type; RecomputeFilteredRuns(); }
    private void ToggleRunSelection(string runId, bool selected) { if (selected) _selectedRunIds.Add(runId); else _selectedRunIds.Remove(runId); }
    private void ToggleSelectAll(bool selectAll)
    {
        _selectAll = selectAll;
        if (selectAll) { foreach (var run in _cachedFilteredRuns) _selectedRunIds.Add(run.Id); }
        else _selectedRunIds.Clear();
    }
    private void NavigateToCompare()
    {
        if (_selectedRunIds.Count >= 2 && _selectedRunIds.Count <= 5)
            Nav.NavigateTo($"/compare?runIds={string.Join(",", _selectedRunIds)}");
    }

    private string? GetLastSharpeStrategyName()
    {
        if (_latestRun is null) return null;
        var match = _strategies.FirstOrDefault(s => (string)s.StrategyType == _latestRun.ScenarioConfig.StrategyType);
        return match?.StrategyName ?? _latestRun.ScenarioConfig.StrategyType;
    }

    private string? GetLastSharpeNavigationTarget()
    {
        if (_latestRun is null) return null;
        return _strategyIdByType.TryGetValue(_latestRun.ScenarioConfig.StrategyType, out var id)
            ? $"/strategies/{id}" : "/backtests/history";
    }

    private static string FormatRunDate(BacktestResult run)
    {
        if (run.CreatedAt != default) return run.CreatedAt.ToString("yyyy-MM-dd");
        return RunIdDateParser.TryParse(run.Id)?.ToString("yyyy-MM-dd") ?? "—";
    }

    private static string FormatRelativeDate(DateTimeOffset date)
    {
        var diff = DateTimeOffset.UtcNow - date;
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalMinutes < 1440) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalMinutes < 10080) return $"{(int)diff.TotalDays}d ago";
        return date.ToString("MMM dd");
    }

    private static string GetSharpeClass(decimal? sharpe)
    {
        if (sharpe >= 1.5m) return "mud-success-text";
        if (sharpe >= 0.8m) return "mud-warning-text";
        return "mud-error-text";
    }

    private static string GetChecklistClass(Application.Research.ResearchChecklist c)
    {
        if (c.PassedCount >= 7) return "mud-success-text";
        if (c.PassedCount >= 5) return "mud-warning-text";
        return "mud-error-text";
    }

    private static Color GetChecklistColor(Application.Research.ResearchChecklist c)
    {
        if (c.PassedCount >= 7) return Color.Success;
        if (c.PassedCount >= 5) return Color.Warning;
        return Color.Error;
    }

    private static string GetStageBadgeClass(DevelopmentStage stage)
    {
        if (stage == DevelopmentStage.Exploring) return "stage-badge-exploring";
        if (stage == DevelopmentStage.Validating) return "stage-badge-validation";
        if (stage == DevelopmentStage.FinalTest) return "stage-badge-finaltest";
        if (stage == DevelopmentStage.Retired) return "stage-badge-retired";
        return "text-muted";
    }
}
