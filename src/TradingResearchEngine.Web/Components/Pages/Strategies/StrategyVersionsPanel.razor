@using TradingResearchEngine.Application.Strategy

<MudText Typo="Typo.subtitle2" Class="text-muted mb-3">VERSION PARAMETERS</MudText>

<MudText Typo="Typo.caption" Class="text-faint mb-1">PARAMETERS</MudText>
<MudSimpleTable Dense="true" Class="mb-3">
    <tbody>
        @foreach (var p in Version.Parameters)
        {
            <tr><td class="text-muted">@p.Key</td><td>@p.Value</td></tr>
        }
    </tbody>
</MudSimpleTable>

<MudText Typo="Typo.caption" Class="text-faint mb-1">EXECUTION</MudText>
<MudSimpleTable Dense="true" Class="mb-3">
    <tbody>
        <tr><td class="text-muted">Fill Mode</td><td>@Version.BaseScenarioConfig.FillMode</td></tr>
        <tr><td class="text-muted">Bars/Year</td><td>@Version.BaseScenarioConfig.BarsPerYear</td></tr>
        <tr><td class="text-muted">Initial Cash</td><td>$@Version.BaseScenarioConfig.InitialCash.ToString("F0")</td></tr>
        <tr><td class="text-muted">Slippage</td><td>@Version.BaseScenarioConfig.SlippageModelType</td></tr>
    </tbody>
</MudSimpleTable>

@* V4: Execution Window *@
<MudText Typo="Typo.caption" Class="text-faint mb-1">EXECUTION WINDOW</MudText>
<MudPaper Outlined="true" Class="pa-3 mb-3">
    <MudSimpleTable Dense="true">
        <tbody>
            <tr><td class="text-muted">Timeframe</td><td>@(ExecWindow.Timeframe ?? "Not set")</td></tr>
            <tr><td class="text-muted">Start</td><td>@(ExecWindow.Start?.ToString("yyyy-MM-dd") ?? "Inherited")</td></tr>
            <tr><td class="text-muted">End</td><td>@(ExecWindow.End?.ToString("yyyy-MM-dd") ?? "Inherited")</td></tr>
            @if (ExecWindow.EstimatedBars.HasValue)
            {
                <tr><td class="text-muted">Est. Bars</td><td>@ExecWindow.EstimatedBars.Value.ToString("N0")</td></tr>
            }
        </tbody>
    </MudSimpleTable>
    <MudButton Size="MudBlazor.Size.Small" Variant="Variant.Text" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Edit" Class="mt-1"
               OnClick="OnEditWindowRequested">Edit Window</MudButton>
</MudPaper>

<MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" Size="MudBlazor.Size.Small"
           Href="@($"/strategies/builder?fromStrategyId={Strategy.StrategyId}&fromVersionId={Version.StrategyVersionId}")">
    New Version from This
</MudButton>

@code {
    [Parameter, EditorRequired] public StrategyVersion Version { get; set; } = default!;
    [Parameter, EditorRequired] public StrategyIdentity Strategy { get; set; } = default!;
    [Parameter] public (string? Timeframe, DateTimeOffset? Start, DateTimeOffset? End, int? EstimatedBars) ExecWindow { get; set; }
    [Parameter] public EventCallback OnEditWindowRequested { get; set; }
}
