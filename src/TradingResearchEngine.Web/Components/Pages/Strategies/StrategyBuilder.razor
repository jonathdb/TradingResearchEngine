@page "/strategies/builder"
@page "/strategies/builder/{DraftId}"
@page "/strategies/new"
@using System.Text.Json
@using TradingResearchEngine.Web.Components.Builder
@using TradingResearchEngine.Web.Services
@using TradingResearchEngine.Application.AI
@using TradingResearchEngine.Application.DataFiles
@using TradingResearchEngine.Application.Engine
@using TradingResearchEngine.Application.Research
@using TradingResearchEngine.Core.Persistence
@inject IReadOnlyList<StrategyTemplate> Templates
@inject IStrategyRepository StrategyRepo
@inject StrategyRegistry Registry
@inject IStrategySchemaProvider SchemaProvider
@inject IRepository<ConfigDraft> DraftRepo
@inject IRepository<ConfigPreset> PresetRepo
@inject IDataFileRepository DataFileRepo
@inject PreflightValidator PreflightValidator
@inject ResolvedConfigService ResolvedConfigService
@inject JobExecutor JobExecutor
@inject IAIStrategyAssistant AIAssistant
@inject DraftAutoSaveService _autoSaveService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@implements IAsyncDisposable

<PageTitle>Strategy Builder — Research Engine</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
    <MudText Typo="Typo.h4">Strategy Builder</MudText>
    @if (_autoSaveService?.LastSavedAt is not null)
    {
        <MudText Typo="Typo.caption" Class="text-muted"
                 aria-label="Draft saved timestamp">
            Draft saved @_autoSaveService.LastSavedAt.Value.ToString("HH:mm:ss")
        </MudText>
    }
</MudStack>

@if (_aiMode)
{
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.h6" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Class="mr-1" />
            AI Strategy Generation
        </MudText>

        @* AI Prompt Input *@
        <MudTextField @bind-Value="_aiPrompt"
                      Label="Describe your strategy idea"
                      Placeholder="e.g., A mean-reversion strategy on SPY using Bollinger Bands with 2 standard deviations..."
                      Lines="3"
                      Variant="Variant.Outlined"
                      Disabled="@_aiStreaming"
                      Class="mb-3" />

        @* Generate / Stop buttons *@
        <MudStack Row="true" Class="mb-3">
            @if (_aiStreaming)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.Stop"
                           OnClick="StopAIGeneration"
                           aria-label="Stop generation">
                    Stop generation
                </MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.AutoAwesome"
                           Disabled="@(string.IsNullOrWhiteSpace(_aiPrompt))"
                           OnClick="StartAIGeneration"
                           aria-label="Generate strategy with AI">
                    Generate with AI
                </MudButton>
            }
        </MudStack>

        @* Streaming output *@
        @if (!string.IsNullOrEmpty(_aiStreamBuffer))
        {
            <MudPaper Class="pa-3 mb-3" Outlined="true" Style="max-height: 300px; overflow-y: auto; font-family: monospace; white-space: pre-wrap;">
                <MudText Typo="Typo.body2">@_aiStreamBuffer</MudText>
                @if (_aiStreaming)
                {
                    <MudProgressCircular Size="MudBlazor.Size.Small" Indeterminate="true" Class="ml-2" />
                }
            </MudPaper>
        }

        @* Error display *@
        @if (!string.IsNullOrEmpty(_aiError))
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@_aiError</MudAlert>
        }

        @* Refine with AI feedback — shown when a draft exists *@
        @if (_aiDraft is not null && !_aiStreaming)
        {
            <MudDivider Class="my-3" />
            <MudText Typo="Typo.subtitle1" Class="mb-2">Refine with AI feedback</MudText>
            <MudStack Row="true" AlignItems="AlignItems.End">
                <MudTextField @bind-Value="_aiRefinePrompt"
                              Label="Refinement feedback"
                              Placeholder="e.g., Increase the lookback period and add a volatility filter..."
                              Variant="Variant.Outlined"
                              Style="flex: 1;" />
                <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           Disabled="@(string.IsNullOrWhiteSpace(_aiRefinePrompt))"
                           OnClick="StartAIRefinement"
                           aria-label="Refine strategy with AI">
                    Refine
                </MudButton>
            </MudStack>
        }

        @* Refinement history *@
        @if (_aiDraft is not null && _aiDraft.RefinementHistory.Count > 0)
        {
            <MudExpansionPanels Class="mt-3" MultiExpansion="false">
                <MudExpansionPanel Text="Refinement History" Expanded="false">
                    @for (var i = 0; i < _aiDraft.RefinementHistory.Count; i++)
                    {
                        var index = i;
                        <MudPaper Class="pa-2 mb-2" Outlined="true">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudText Typo="Typo.body2">@_aiDraft.RefinementHistory[index]</MudText>
                                <MudButton Variant="Variant.Text" Color="Color.Primary"
                                           Size="MudBlazor.Size.Small"
                                           OnClick="@(() => RevertToVersion(index))"
                                           aria-label="@($"Revert to version {index + 1}")">
                                    Revert to this version
                                </MudButton>
                            </MudStack>
                        </MudPaper>
                    }
                </MudExpansionPanel>
            </MudExpansionPanels>
        }

        @* Transition to wizard when draft is ready *@
        @if (_aiDraft is not null && !_aiStreaming)
        {
            <MudDivider Class="my-3" />
            <MudAlert Severity="Severity.Success" Class="mb-2">
                Strategy draft generated. Form fields have been auto-populated. Continue with the wizard below to review and launch.
            </MudAlert>
        }
    </MudPaper>
}

<BuilderStepIndicator CurrentStep="@_vm.CurrentStep" MaxVisitedStep="@_vm.MaxVisitedStep" OnStepSelected="GoToStep" />

<MudGrid>
    @* Primary content area (~65%) *@
    <MudItem xs="12" md="8">
        @switch (_vm.CurrentStep)
        {
            case 1:
                <Step1ChooseStartingPoint Model="@_vm"
                                          Templates="@Templates"
                                          Strategies="@_strategies"
                                          KnownStrategies="@_knownStrategies"
                                          OnTemplateSelected="OnTemplateSelected"
                                          OnForkSelected="HandleForkSelected"
                                          OnModelChanged="OnModelChanged"
                                          OnImportJsonChanged="HandleImportJsonChanged" />
                break;
            case 2:
                <Step2DataExecutionWindow Model="@_vm"
                                          DataFiles="@_dataFiles"
                                          OnModelChanged="OnModelChanged" />
                break;
            case 3:
                <Step3StrategyParameters Model="@_vm"
                                         Schemas="@_schemas"
                                         PresetParameters="@_presetParameters"
                                         OnModelChanged="OnModelChanged" />
                break;
            case 4:
                <Step4RealismRiskProfile Model="@_vm"
                                         Presets="@_presets"
                                         OnModelChanged="OnModelChanged" />
                break;
            case 5:
                <Step5ReviewLaunch Model="@_vm"
                                   ResolvedConfig="@_resolvedConfig"
                                   PreflightResult="@_preflightResult"
                                   Saving="@_saving"
                                   OnAction="OnLaunchAction" />
                break;
        }

        @* Step navigation *@
        <MudStack Row="true" Class="mt-4" Justify="Justify.SpaceBetween">
            @if (_vm.CurrentStep > 1)
            {
                <MudButton Variant="Variant.Text" OnClick="PreviousStep"
                           aria-label="Go to previous step">
                    ← Back
                </MudButton>
            }
            else
            {
                <div></div>
            }
            @if (_vm.CurrentStep < 5)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           Disabled="@(!CanAdvance())"
                           OnClick="NextStep"
                           aria-label="Go to next step">
                    Next →
                </MudButton>
            }
        </MudStack>
    </MudItem>

    @* Research Summary Rail (~35%) *@
    <MudItem xs="12" md="4">
        <ResearchSummaryRail Model="@_vm"
                             Schemas="@_schemas"
                             PreflightResult="@_preflightResult" />
    </MudItem>
</MudGrid>

@code {
    [Parameter] public string? DraftId { get; set; }
    [SupplyParameterFromQuery(Name = "mode")] public string? Mode { get; set; }

    private BuilderViewModel _vm = new();
    private IReadOnlyList<StrategyIdentity> _strategies = Array.Empty<StrategyIdentity>();
    private IReadOnlyList<string> _knownStrategies = Array.Empty<string>();
    private IReadOnlyList<DataFileRecord> _dataFiles = Array.Empty<DataFileRecord>();
    private IReadOnlyList<StrategyParameterSchema> _schemas = Array.Empty<StrategyParameterSchema>();
    private IReadOnlyList<ConfigPreset> _presets = Array.Empty<ConfigPreset>();
    private Dictionary<string, object>? _presetParameters;
    private PreflightResult? _preflightResult;
    private ResolvedConfig? _resolvedConfig;
    private bool _saving;
    private string? _importJson;

    // AI mode state
    private bool _aiMode;
    private string _aiPrompt = "";
    private string _aiRefinePrompt = "";
    private string _aiStreamBuffer = "";
    private string? _aiError;
    private bool _aiStreaming;
    private AIStrategyDraft? _aiDraft;
    private CancellationTokenSource? _aiCts;
    private List<AIStrategyDraft> _aiDraftHistory = new();

    /// <summary>Debounce delay for step persistence (500ms).</summary>
    private const int StepPersistDebounceMs = 500;
    private CancellationTokenSource? _debounceCts;

    protected override async Task OnInitializedAsync()
    {
        // Detect AI mode from query string
        _aiMode = string.Equals(Mode, "ai", StringComparison.OrdinalIgnoreCase);

        // Load reference data
        _strategies = await StrategyRepo.ListAsync();
        _knownStrategies = Registry.KnownNames;
        _dataFiles = await DataFileRepo.ListAsync();
        _presets = await PresetRepo.ListAsync();

        // Resume draft if ID provided
        if (!string.IsNullOrWhiteSpace(DraftId))
        {
            var draft = await DraftRepo.GetByIdAsync(DraftId);
            if (draft is not null)
            {
                _vm = BuilderViewModel.FromDraft(draft);
                LoadSchemaForCurrentStrategy();
            }
        }

        // Set source type for AI mode
        if (_aiMode)
        {
            _vm.SourceType = SourceType.AIGenerated;
        }
    }

    private Task OnTemplateSelected(StrategyTemplate tpl)
    {
        _vm.TemplateId = tpl.TemplateId;
        _vm.StrategyType = tpl.StrategyType;
        _vm.Parameters = new Dictionary<string, object>(tpl.DefaultParameters);
        _vm.Timeframe = tpl.RecommendedTimeframe;
        _vm.Hypothesis ??= tpl.Descriptor?.Hypothesis;
        _vm.IsDirty = true;

        // In beginner mode, apply the template's default realism profile to ensure
        // realistic execution assumptions. Never default to FastResearch in beginner mode.
        if (_vm.IsBeginnerMode)
        {
            _vm.RealismProfile = tpl.DefaultRealismProfile;
        }

        _presetParameters = new Dictionary<string, object>(tpl.DefaultParameters);
        LoadSchemaForCurrentStrategy();
        return Task.CompletedTask;
    }

    private async Task HandleForkSelected(StrategyIdentity identity)
    {
        var latestVersion = await StrategyRepo.GetLatestVersionAsync(identity.StrategyId);
        if (latestVersion is null)
        {
            Snackbar.Add($"'{identity.StrategyName}' has no versions to fork.", Severity.Warning);
            return;
        }

        _vm.StrategyType = latestVersion.BaseScenarioConfig.EffectiveStrategyConfig.StrategyType;
        _vm.Parameters = new Dictionary<string, object>(latestVersion.Parameters);
        _vm.Timeframe = latestVersion.BaseScenarioConfig.Timeframe ?? "Daily";
        _vm.Hypothesis = latestVersion.Hypothesis;
        _vm.SourceType = SourceType.Fork;
        _vm.IsDirty = true;
        LoadSchemaForCurrentStrategy();
        StateHasChanged();
    }

    private void LoadSchemaForCurrentStrategy()
    {
        if (_vm.StrategyType is not null)
        {
            try { _schemas = SchemaProvider.GetSchema(_vm.StrategyType); }
            catch { _schemas = Array.Empty<StrategyParameterSchema>(); }
        }
    }

    private async Task NextStep()
    {
        if (!CanAdvance()) return;

        // Attempt import JSON deserialization before advancing from Step 1
        if (_vm.CurrentStep == 1 && _vm.SourceType == SourceType.Import)
        {
            if (string.IsNullOrWhiteSpace(_importJson))
            {
                Snackbar.Add("Please paste a JSON config to import.", Severity.Error);
                return;
            }

            try
            {
                var config = JsonSerializer.Deserialize<ScenarioConfig>(_importJson,
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (config is null) throw new JsonException("Deserialised to null.");
                PopulateFromImport(config);
            }
            catch (JsonException ex)
            {
                Snackbar.Add($"Invalid JSON: {ex.Message}", Severity.Error);
                return; // stay on Step 1
            }
        }

        _vm.CurrentStep++;
        _vm.MaxVisitedStep = Math.Max(_vm.MaxVisitedStep, _vm.CurrentStep);
        _vm.IsDirty = true;
        DebouncePersistStep();

        // Load resolved config and preflight on step 5
        if (_vm.CurrentStep == 5)
            await RunPreflightAndResolve();
    }

    private Task PreviousStep()
    {
        if (_vm.CurrentStep > 1)
        {
            _vm.CurrentStep--;
            DebouncePersistStep();
        }
        return Task.CompletedTask;
    }

    private Task GoToStep(int step)
    {
        if (step >= 1 && step <= _vm.MaxVisitedStep)
        {
            _vm.CurrentStep = step;
            DebouncePersistStep();
        }
        return Task.CompletedTask;
    }

    private async Task PersistDraft()
    {
        try
        {
            var draft = _vm.ToConfigDraft();
            var validationErrors = ConfigDraftValidator.ValidateStep(draft);
            if (validationErrors.Count > 0)
            {
                foreach (var error in validationErrors)
                    Snackbar.Add(error, Severity.Warning);
                return;
            }
            await DraftRepo.SaveAsync(draft);
            _vm.IsDirty = false;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to save draft: {ex.Message}", Severity.Warning);
        }
    }

    /// <summary>
    /// Debounced step persistence. Cancels any pending save and schedules a new one
    /// after <see cref="StepPersistDebounceMs"/> milliseconds.
    /// </summary>
    private void DebouncePersistStep()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(StepPersistDebounceMs, token);
                if (!token.IsCancellationRequested)
                {
                    await InvokeAsync(async () =>
                    {
                        await PersistDraft();
                    });
                }
            }
            catch (TaskCanceledException)
            {
                // Debounce cancelled — expected when user navigates quickly
            }
        }, token);
    }

    private async Task RunPreflightAndResolve()
    {
        try
        {
            var config = _vm.ToScenarioConfig();
            _preflightResult = PreflightValidator.Validate(config);
            _resolvedConfig = await ResolvedConfigService.ResolveAsync(config, _vm.PresetId);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Preflight error: {ex.Message}", Severity.Warning);
        }
    }

    private Task OnModelChanged()
    {
        _vm.IsDirty = true;
        _autoSaveService.ScheduleSave(_vm.ToConfigDraft());
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task HandleImportJsonChanged(string? json)
    {
        _importJson = json;
        return Task.CompletedTask;
    }

    private void PopulateFromImport(ScenarioConfig config)
    {
        _vm.StrategyType = config.EffectiveStrategyConfig.StrategyType;
        _vm.Parameters = new Dictionary<string, object>(config.EffectiveStrategyConfig.StrategyParameters);
        _vm.SlippageModelType = config.EffectiveExecutionConfig.SlippageModelType;
        _vm.CommissionModelType = config.EffectiveExecutionConfig.CommissionModelType;
        _vm.FillDelayBars = config.EffectiveExecutionConfig.FillDelayBars;
        _vm.InitialCash = config.EffectiveRiskConfig.InitialCash;
        _vm.AnnualRiskFreeRate = config.EffectiveRiskConfig.AnnualRiskFreeRate;
        _vm.SourceType = SourceType.Import;
        _vm.IsDirty = true;
        LoadSchemaForCurrentStrategy();
    }

    private bool CanAdvance() => _vm.CurrentStep switch
    {
        1 => (_vm.SourceType == SourceType.Template && _vm.TemplateId is not null) ||
             _vm.SourceType == SourceType.Manual ||
             _vm.SourceType == SourceType.Fork ||
             _vm.SourceType == SourceType.Import ||
             _vm.SourceType == SourceType.AIGenerated,
        2 => !string.IsNullOrWhiteSpace(_vm.DataFilePath),
        3 => SchemaValidator.ValidateParameters(_vm.Parameters, _schemas).Count == 0,
        4 => SchemaValidator.ValidateRiskProfile(_vm.PresetOverrides, _vm.StopLoss).Count == 0,
        _ => false
    };

    private async Task OnLaunchAction(string action)
    {
        _saving = true;
        StateHasChanged();

        try
        {
            switch (action)
            {
                case "save-draft":
                    await SaveDraftAndVersion();
                    Snackbar.Add("Draft saved.", Severity.Success);
                    Nav.NavigateTo("/strategies/library");
                    break;

                case "quick-sanity":
                    var (_, version) = await SaveDraftAndVersion();
                    var quickConfig = BuildQuickSanityConfig() with { StrategyVersionId = version.StrategyVersionId };
                    var quickJobId = await JobExecutor.SubmitAsync(JobType.SingleRun, quickConfig);
                    Nav.NavigateTo($"/backtests/job/{quickJobId}");
                    break;

                case "standard-backtest":
                    var (_, sv) = await SaveDraftAndVersion();
                    var stdConfig = _vm.ToScenarioConfig() with { StrategyVersionId = sv.StrategyVersionId };
                    var stdJobId = await JobExecutor.SubmitAsync(JobType.SingleRun, stdConfig);
                    Nav.NavigateTo($"/backtests/job/{stdJobId}");
                    break;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    private async Task<(StrategyIdentity, StrategyVersion)> SaveDraftAndVersion()
    {
        var strategyId = StrategyIdGenerator.Generate(_vm.StrategyName);

        var identity = new StrategyIdentity(strategyId, _vm.StrategyName,
            _vm.StrategyType ?? "", DateTimeOffset.UtcNow, null,
            Hypothesis: _vm.Hypothesis);
        await StrategyRepo.SaveAsync(identity);

        var version = _vm.ToStrategyVersion(strategyId, 1);
        await StrategyRepo.SaveVersionAsync(version);

        // Persist final draft
        await PersistDraft();

        return (identity, version);
    }

    /// <summary>
    /// Builds a transient ScenarioConfig with reduced settings for quick sanity checks.
    /// Overrides are never persisted to ConfigDraft or StrategyVersion.
    /// </summary>
    private ScenarioConfig BuildQuickSanityConfig()
    {
        var baseConfig = _vm.ToScenarioConfig();

        // Apply reduced date range: last 2 years from today
        var reducedDataOpts = new Dictionary<string, object>(baseConfig.DataProviderOptions);
        var twoYearsAgo = DateTimeOffset.UtcNow.AddYears(-2);
        reducedDataOpts["From"] = twoYearsAgo;
        reducedDataOpts["To"] = DateTimeOffset.UtcNow;

        return baseConfig with
        {
            RealismProfile = ExecutionRealismProfile.FastResearch,
            FillMode = FillMode.SameBarClose,
            DataProviderOptions = reducedDataOpts,
            // MaxTrials is not a config field; we use a single run (no sweep/MC)
            ResearchWorkflowType = null,
            ResearchWorkflowOptions = null
        };
    }

    public ValueTask DisposeAsync()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        _debounceCts = null;
        _aiCts?.Cancel();
        _aiCts?.Dispose();
        _aiCts = null;
        return ValueTask.CompletedTask;
    }

    // ─── AI Streaming Methods ───────────────────────────────────────────────────

    private async Task StartAIGeneration()
    {
        if (string.IsNullOrWhiteSpace(_aiPrompt)) return;

        _aiError = null;
        _aiStreamBuffer = "";
        _aiStreaming = true;
        _aiCts?.Cancel();
        _aiCts?.Dispose();
        _aiCts = new CancellationTokenSource();
        _aiCts.CancelAfter(TimeSpan.FromSeconds(120)); // 2-minute timeout
        var ct = _aiCts.Token;

        StateHasChanged();

        try
        {
            await foreach (var token in AIAssistant.StreamGenerateAsync(_aiPrompt, ct))
            {
                _aiStreamBuffer += token;
                StateHasChanged();
            }

            // Stream completed — parse as AIStrategyDraft
            await ParseAndPopulateDraft(_aiStreamBuffer);
        }
        catch (OperationCanceledException)
        {
            // Distinguish timeout from user cancellation
            _aiError = _aiStreamBuffer.Length > 0 && !_aiStreamBuffer.EndsWith("}")
                ? "Generation timed out. Try a simpler prompt or try again."
                : "Generation stopped by user.";
        }
        catch (Exception ex)
        {
            _aiError = $"AI generation failed: {ex.Message}";
        }
        finally
        {
            _aiStreaming = false;
            StateHasChanged();
        }
    }

    private async Task StartAIRefinement()
    {
        if (string.IsNullOrWhiteSpace(_aiRefinePrompt) || _aiDraft is null) return;

        _aiError = null;
        _aiStreamBuffer = "";
        _aiStreaming = true;
        _aiCts?.Cancel();
        _aiCts?.Dispose();
        _aiCts = new CancellationTokenSource();
        _aiCts.CancelAfter(TimeSpan.FromSeconds(120)); // 2-minute timeout
        var ct = _aiCts.Token;

        // Save current draft to history before refining
        _aiDraftHistory.Add(_aiDraft);

        StateHasChanged();

        try
        {
            await foreach (var token in AIAssistant.StreamRefineAsync(_aiDraft, _aiRefinePrompt, ct))
            {
                _aiStreamBuffer += token;
                StateHasChanged();
            }

            // Stream completed — parse refined draft
            await ParseAndPopulateDraft(_aiStreamBuffer);
            _aiRefinePrompt = "";
        }
        catch (OperationCanceledException)
        {
            _aiError = _aiStreamBuffer.Length > 0 && !_aiStreamBuffer.EndsWith("}")
                ? "Refinement timed out. Try a simpler prompt or try again."
                : "Refinement stopped by user.";
        }
        catch (Exception ex)
        {
            _aiError = $"AI refinement failed: {ex.Message}";
        }
        finally
        {
            _aiStreaming = false;
            StateHasChanged();
        }
    }

    private void StopAIGeneration()
    {
        _aiCts?.Cancel();
    }

    private Task ParseAndPopulateDraft(string json)
    {
        try
        {
            var options = new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true,
                PropertyNamingPolicy = JsonNamingPolicy.CamelCase
            };

            var draft = JsonSerializer.Deserialize<AIStrategyDraft>(json, options);
            if (draft is null)
            {
                _aiError = "Failed to parse AI response as a strategy draft. The raw output is shown above.";
                return Task.CompletedTask;
            }

            // Build refinement history from draft history
            var history = _aiDraftHistory.Select(d => d.StrategyName + ": " + d.Rationale).ToList();
            _aiDraft = draft with { RefinementHistory = history };

            // Auto-populate form fields
            PopulateFromAIDraft(_aiDraft);
            _aiError = null;
        }
        catch (JsonException)
        {
            _aiError = "Failed to parse AI response as valid JSON. The raw output is shown above for manual review.";
        }

        return Task.CompletedTask;
    }

    private void PopulateFromAIDraft(AIStrategyDraft draft)
    {
        _vm.StrategyName = draft.StrategyName;
        _vm.StrategyType = draft.StrategyType;
        _vm.Hypothesis = draft.Hypothesis;
        _vm.Parameters = new Dictionary<string, object>(draft.Parameters);
        _vm.SourceType = SourceType.AIGenerated;
        _vm.InitialCash = draft.SuggestedRisk.InitialCash;
        _vm.AnnualRiskFreeRate = draft.SuggestedRisk.AnnualRiskFreeRate;
        _vm.IsDirty = true;
        LoadSchemaForCurrentStrategy();
    }

    private void RevertToVersion(int index)
    {
        if (index < 0 || index >= _aiDraftHistory.Count) return;

        var reverted = _aiDraftHistory[index];
        // Trim history to the reverted point
        _aiDraftHistory = _aiDraftHistory.Take(index).ToList();

        var history = _aiDraftHistory.Select(d => d.StrategyName + ": " + d.Rationale).ToList();
        _aiDraft = reverted with { RefinementHistory = history };

        PopulateFromAIDraft(_aiDraft);
        _aiStreamBuffer = "";
        _aiError = null;
        StateHasChanged();
    }


}
