@page "/research/study/{StudyId}"
@using TradingResearchEngine.Web.Components.Studies
@implements IDisposable
@inject TradingResearchEngine.Application.Research.IStudyRepository StudyRepo
@inject IStrategyRepository StrategyRepo
@inject TradingResearchEngine.Application.Research.BackgroundStudyService StudyService
@inject TradingResearchEngine.Application.Research.StudyInterpretationService InterpretationService
@inject NavigationManager Nav

<PageTitle>Study Detail — TradingResearchEngine</PageTitle>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_study is null)
{
    <MudAlert Severity="Severity.Warning">Study not found.</MudAlert>
}
else
{
    @* Header *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">@_study.Type Study</MudText>
            <MudText Typo="Typo.caption" Class="text-muted">
                @(_strategyName ?? "Unknown strategy") · @_study.CreatedAt.ToString("yyyy-MM-dd HH:mm")
            </MudText>
        </MudStack>
        <MudSpacer />
        <MudChip T="string" Size="MudBlazor.Size.Large"
                 Color="@(_study.Status == TradingResearchEngine.Application.Research.StudyStatus.Completed ? Color.Success : Color.Warning)">
            @_study.Status
        </MudChip>
    </MudStack>

    @* KPI row *@
    <MudGrid Class="mb-4">
        <MudItem xs="6" sm="3">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.caption" Class="text-muted">Type</MudText>
                <MudText Typo="Typo.h6">@_study.Type</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.caption" Class="text-muted">Status</MudText>
                <MudText Typo="Typo.h6">@_study.Status</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.caption" Class="text-muted">Source Run</MudText>
                <MudText Typo="Typo.h6">@(_study.SourceRunId?[..Math.Min(8, _study.SourceRunId.Length)] ?? "—")…</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.caption" Class="text-muted">Strategy Version</MudText>
                <MudText Typo="Typo.h6">@_study.StrategyVersionId[..Math.Min(12, _study.StrategyVersionId.Length)]…</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @if (_study.Status == TradingResearchEngine.Application.Research.StudyStatus.Failed && _study.ErrorSummary is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">
            <MudText Typo="Typo.body1">Study failed: @_study.ErrorSummary</MudText>
        </MudAlert>
    }

    @* Live progress bar *@
    @if (_study.Status == TradingResearchEngine.Application.Research.StudyStatus.Running && _progressTotal > 0)
    {
        <MudPaper Class="pa-3 mb-4" Elevation="1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-1">
                <MudText Typo="Typo.body2">@_progressLabel</MudText>
                <MudSpacer />
                <MudText Typo="Typo.caption" Class="text-muted">@_progressCurrent / @_progressTotal</MudText>
            </MudStack>
            <MudProgressLinear Value="@(_progressTotal > 0 ? (double)_progressCurrent * 100.0 / _progressTotal : 0)"
                               Color="Color.Primary" Rounded="true" Size="MudBlazor.Size.Medium" />
        </MudPaper>
    }
    else if (_study.Status == TradingResearchEngine.Application.Research.StudyStatus.Running)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
    }

    @* Interpretation *@
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.subtitle1">Interpretation</MudText>
        <MudText Typo="Typo.body2" Style="opacity:0.8">
            @GetInterpretation()
        </MudText>
    </MudPaper>

    @* V7: Results rendering via pluggable renderer pattern *@
    @if (_study.ResultJson is not null && _study.Status == TradingResearchEngine.Application.Research.StudyStatus.Completed)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudText Typo="Typo.subtitle1" Class="mb-3">Results</MudText>
            @{
                var rendererType = StudyRendererRegistry.GetRenderer(_study.Type);
            }
            @if (rendererType is not null)
            {
                <DynamicComponent Type="rendererType"
                    Parameters="@(new Dictionary<string, object> { ["Study"] = _study, ["ResultJson"] = _study.ResultJson! })" />
            }
            else
            {
                <MudAlert Severity="Severity.Info">No renderer available for study type "@_study.Type".</MudAlert>
            }
        </MudPaper>
    }

    @* Actions *@
    <MudStack Row="true" Spacing="2">
        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.AccountBalance"
                   Href="/propfirm/evaluate">Evaluate for Prop Firm</MudButton>
        @if (_study.SourceRunId is not null)
        {
            <MudButton Variant="Variant.Text" Color="Color.Primary"
                       Href="@($"/backtests/{_study.SourceRunId}")">View Source Run</MudButton>
        }
    </MudStack>
}

@code {
    [Parameter] public string StudyId { get; set; } = "";

    private TradingResearchEngine.Application.Research.StudyRecord? _study;
    private string? _strategyName;
    private bool _loading = true;
    private int _progressCurrent;
    private int _progressTotal;
    private string _progressLabel = "";

    protected override async Task OnInitializedAsync()
    {
        _study = await StudyRepo.GetAsync(StudyId);
        if (_study is not null)
        {
            var version = await StrategyRepo.GetVersionAsync(_study.StrategyVersionId);
            if (version is not null)
            {
                var strategy = await StrategyRepo.GetAsync(version.StrategyId);
                _strategyName = strategy?.StrategyName;
            }

            // Subscribe to progress events if study is still running
            if (_study.Status == TradingResearchEngine.Application.Research.StudyStatus.Running)
            {
                StudyService.OnProgress += HandleProgress;
                StudyService.OnCompleted += HandleCompleted;
            }
        }
        _loading = false;
    }

    private void HandleProgress(TradingResearchEngine.Application.Research.StudyProgressUpdate update)
    {
        if (update.StudyId != StudyId) return;
        _progressCurrent = update.Current;
        _progressTotal = update.Total;
        _progressLabel = update.Label;
        InvokeAsync(StateHasChanged);
    }

    private void HandleCompleted(TradingResearchEngine.Application.Research.StudyCompletionUpdate update)
    {
        if (update.StudyId != StudyId) return;
        InvokeAsync(async () =>
        {
            _study = await StudyRepo.GetAsync(StudyId);
            _progressCurrent = 0;
            _progressTotal = 0;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        StudyService.OnProgress -= HandleProgress;
        StudyService.OnCompleted -= HandleCompleted;
    }

    private string GetInterpretation()
    {
        // Try dynamic interpretation from results if available
        if (_study?.ResultJson is not null && _study.Status == TradingResearchEngine.Application.Research.StudyStatus.Completed)
        {
            try
            {
                return _study.Type switch
                {
                    TradingResearchEngine.Application.Research.StudyType.MonteCarlo =>
                        InterpretationService.InterpretMonteCarlo(
                            System.Text.Json.JsonSerializer.Deserialize<TradingResearchEngine.Application.Research.Results.MonteCarloResult>(_study.ResultJson)!),
                    TradingResearchEngine.Application.Research.StudyType.WalkForward or
                    TradingResearchEngine.Application.Research.StudyType.AnchoredWalkForward =>
                        InterpretationService.InterpretWalkForward(
                            System.Text.Json.JsonSerializer.Deserialize<TradingResearchEngine.Application.Research.Results.WalkForwardResult>(_study.ResultJson)!),
                    TradingResearchEngine.Application.Research.StudyType.Cpcv =>
                        InterpretationService.InterpretCpcv(
                            System.Text.Json.JsonSerializer.Deserialize<TradingResearchEngine.Application.Research.Results.CpcvResult>(_study.ResultJson)!),
                    TradingResearchEngine.Application.Research.StudyType.ParameterSweep =>
                        InterpretationService.InterpretParameterSweep(
                            System.Text.Json.JsonSerializer.Deserialize<TradingResearchEngine.Application.Research.Results.SweepResult>(_study.ResultJson)!),
                    TradingResearchEngine.Application.Research.StudyType.BenchmarkComparison =>
                        InterpretationService.InterpretBenchmark(
                            System.Text.Json.JsonSerializer.Deserialize<TradingResearchEngine.Application.Research.Results.BenchmarkComparisonResult>(_study.ResultJson)!),
                    _ => GetStaticInterpretation()
                };
            }
            catch { /* Fall through to static interpretation */ }
        }

        return GetStaticInterpretation();
    }

    private string GetStaticInterpretation() => _study?.Type switch
    {
        TradingResearchEngine.Application.Research.StudyType.MonteCarlo =>
            "Monte Carlo simulation resamples trade returns to estimate the distribution of possible outcomes. Look at P10 (worst case), P50 (median), and P90 (best case) end equity, plus ruin probability.",
        TradingResearchEngine.Application.Research.StudyType.WalkForward =>
            "Walk-forward analysis validates that in-sample optimized parameters generalize to out-of-sample data. Check the composite OOS equity curve and parameter drift score.",
        TradingResearchEngine.Application.Research.StudyType.Sensitivity =>
            "Sensitivity analysis tests how performance degrades under increased costs and execution delays. A robust strategy should maintain positive Sharpe under most perturbations.",
        TradingResearchEngine.Application.Research.StudyType.ParameterStability =>
            "Parameter stability evaluates whether the best parameter set is robust or fragile. A low fragility score means nearby parameter combinations also perform well.",
        _ => "This study evaluates strategy robustness from a specific angle. Review the results to assess whether the strategy's edge is reliable."
    };
}

