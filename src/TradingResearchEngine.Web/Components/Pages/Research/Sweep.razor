@page "/research/sweep"
@inject TradingResearchEngine.Application.Research.ParameterSweepWorkflow SweepWorkflow
@inject IStrategyRepository StrategyRepo
@inject IStrategySchemaProvider SchemaProvider
@inject ISnackbar Snackbar
@inject ILogger<Sweep> Logger

@using TradingResearchEngine.Web.Features.Research.Sweep

<PageTitle>Parameter Sweep — Research Engine</PageTitle>

<div class="page-header">
    <div class="page-header__title">
        <MudText Typo="Typo.h5">Parameter Sweep</MudText>
        <MudText Typo="Typo.caption" Class="text-muted">Exhaustively test a grid of parameter combinations to find robust configurations</MudText>
    </div>
</div>

<MudGrid>
    <MudItem xs="12" md="7">
        <MudPaper Class="pa-4" Elevation="2">
            <StrategyVersionPicker PreselectedStrategyId="@StrategyId" PreselectedVersionId="@VersionId"
                                   OnSelectionChanged="OnVersionSelected" />

            <MudExpansionPanels Class="mt-3 mb-3">
                <MudExpansionPanel Text="Advanced / Manual Config" Expanded="false">
                    <ScenarioConfigEditor @ref="_configEditor" />
                </MudExpansionPanel>
            </MudExpansionPanels>

            <MudDivider Class="my-4" />
            <MudText Typo="Typo.h6" Class="mb-3">Parameter Grid</MudText>
            <MudText Typo="Typo.caption" Class="mb-2">
                Add parameters to sweep. Define Low, High, and Increment for each parameter.
            </MudText>

            @foreach (var row in _rows)
            {
                <SweepParameterRow Schema="_schema"
                                   UsedParametersByOtherRows="GetUsedParametersByOtherRows(row)"
                                   Model="row"
                                   OnChanged="OnRowChanged"
                                   OnRemoved="@(() => RemoveRow(row))" />
            }

            <MudButton Variant="Variant.Text" Color="MudBlazor.Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AddRow">
                Add Parameter
            </MudButton>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="5">
        <MudPaper Class="pa-4" Elevation="2">
            <WorkflowRunner TResult="TradingResearchEngine.Application.Research.Results.SweepResult"
                            ButtonText="Run Sweep"
                            OnExecute="ExecuteSweep">
                <ResultContent Context="result">
                    <MudText Typo="Typo.h6" Class="mb-2">
                        @result.Results.Count results — Best Sharpe: @(result.RankedBySharpe.FirstOrDefault()?.SharpeRatio?.ToString("F2") ?? "N/A")
                    </MudText>

                    @if (result.ParameterSensitivity.Count > 0)
                    {
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Parameter Sensitivity (lower = more robust)</MudText>
                        <MudSimpleTable Dense="true">
                            <thead><tr><th>Parameter</th><th>Sensitivity</th></tr></thead>
                            <tbody>
                                @foreach (var kv in result.ParameterSensitivity)
                                {
                                    <tr><td>@kv.Key</td><td>@kv.Value.ToString("F4")</td></tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }

                    <MudText Typo="Typo.subtitle2" Class="mt-3 mb-2">Ranked by Sharpe</MudText>
                    <MudTable Items="result.RankedBySharpe" Dense="true" Hover="true">
                        <HeaderContent>
                            <MudTh>Scenario</MudTh>
                            <MudTh>Sharpe</MudTh>
                            <MudTh>Max DD</MudTh>
                            <MudTh>Trades</MudTh>
                            <MudTh>End Equity</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.ScenarioConfig.ScenarioId</MudTd>
                            <MudTd>@(context.SharpeRatio?.ToString("F2") ?? "N/A")</MudTd>
                            <MudTd>@context.MaxDrawdown.ToString("P2")</MudTd>
                            <MudTd>@context.TotalTrades</MudTd>
                            <MudTd>$@context.EndEquity.ToString("F2")</MudTd>
                        </RowTemplate>
                    </MudTable>

                    @* V6: Parameter Sweep Heatmap *@
                    <TradingResearchEngine.Web.Components.Charts.ParameterSweepHeatmap
                        SweepResult="result"
                        MetricName="Sharpe" />
                </ResultContent>
            </WorkflowRunner>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    [SupplyParameterFromQuery] public string? StrategyId { get; set; }
    [SupplyParameterFromQuery] public string? VersionId { get; set; }

    private ScenarioConfigEditor? _configEditor;
    private List<SweepRowModel> _rows = new() { new() };
    private IReadOnlyList<StrategyParameterSchema>? _schema;

    private void OnVersionSelected((StrategyIdentity Strategy, StrategyVersion Version, BacktestResult? LatestRun) selection)
    {
        _configEditor?.LoadFromConfig(selection.Version.BaseScenarioConfig);
        LoadSchema(selection.Strategy.StrategyType);
    }

    /// <summary>
    /// Loads the parameter schema for the selected strategy type.
    /// On failure, sets schema to null which causes SweepParameterRow to fall back to free-text input.
    /// </summary>
    private void LoadSchema(string strategyType)
    {
        try
        {
            _schema = SchemaProvider.GetSchema(strategyType);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load schema for strategy type '{StrategyType}'. Falling back to free-text input.", strategyType);
            _schema = null;
        }
    }

    /// <summary>
    /// Computes the set of parameter names used by all rows except the given row.
    /// Used to prevent duplicate parameter selection across rows.
    /// </summary>
    private HashSet<string> GetUsedParametersByOtherRows(SweepRowModel currentRow)
    {
        return _rows
            .Where(r => !ReferenceEquals(r, currentRow))
            .Where(r => !string.IsNullOrWhiteSpace(r.ParameterName))
            .Select(r => r.ParameterName)
            .ToHashSet();
    }

    /// <summary>
    /// Called when any row's parameter or range values change.
    /// Triggers re-render so sibling rows update their available parameter dropdowns.
    /// </summary>
    private void OnRowChanged(SweepRowModel _)
    {
        StateHasChanged();
    }

    /// <summary>
    /// Adds a new row with the first unused parameter auto-selected via SweepParameterSelector.
    /// </summary>
    private void AddRow()
    {
        var newRow = new SweepRowModel();

        if (_schema is not null && _schema.Count > 0)
        {
            var usedNames = _rows
                .Where(r => !string.IsNullOrWhiteSpace(r.ParameterName))
                .Select(r => r.ParameterName)
                .ToHashSet();

            var nextParam = SweepParameterSelector.SelectNext(_schema, usedNames);
            if (nextParam is not null)
            {
                newRow.ParameterName = nextParam;
            }
        }

        _rows.Add(newRow);
    }

    private void RemoveRow(SweepRowModel row)
    {
        _rows.Remove(row);
        StateHasChanged();
    }

    private async Task<TradingResearchEngine.Application.Research.Results.SweepResult> ExecuteSweep(CancellationToken ct)
    {
        // Validate all rows via SweepRangeGenerator before executing
        var hasInvalidRows = _rows
            .Where(r => !string.IsNullOrWhiteSpace(r.ParameterName))
            .Any(r => SweepRangeGenerator.Generate(r.Low, r.High, r.Increment) is null);

        if (hasInvalidRows)
        {
            throw new InvalidOperationException(
                "One or more parameter rows have invalid range inputs. Please fix all validation errors before running the sweep.");
        }

        var config = _configEditor!.BuildConfig();

        // Build parameter grid from UI rows using range generation
        var grid = new Dictionary<string, object>();
        foreach (var row in _rows.Where(r => !string.IsNullOrWhiteSpace(r.ParameterName)))
        {
            var values = SweepRangeGenerator.Generate(row.Low, row.High, row.Increment);
            if (values is not null)
            {
                grid[row.ParameterName] = values.Cast<object>().ToList();
            }
        }

        var configWithGrid = config with
        {
            ResearchWorkflowOptions = new Dictionary<string, object> { ["ParameterGrid"] = grid }
        };

        var options = new TradingResearchEngine.Application.Configuration.SweepOptions();
        return await SweepWorkflow.RunAsync(configWithGrid, options, ct);
    }
}
