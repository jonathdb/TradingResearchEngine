@page "/research/benchmark"
@inject TradingResearchEngine.Application.Research.BenchmarkComparisonWorkflow BenchWorkflow
@inject TradingResearchEngine.Core.Persistence.IRepository<BacktestResult> ResultRepo
@inject IStrategyRepository StrategyRepo
@inject TradingResearchEngine.Application.Research.IBacktestResultRepository BacktestResultRepo
@inject ISnackbar Snackbar

<PageTitle>Benchmark Comparison — Research Engine</PageTitle>

<div class="page-header">
    <div class="page-header__title">
        <MudText Typo="Typo.h5">Benchmark Comparison</MudText>
        <MudText Typo="Typo.caption" Class="text-muted">Compare a strategy's performance against a buy-and-hold benchmark</MudText>
    </div>
</div>

@if (!_hasResults)
{
    <MudPaper Class="pa-8 d-flex flex-column align-center justify-center" Elevation="0" Style="text-align:center; border: 1px dashed var(--mud-palette-divider);">
        <MudIcon Icon="@Icons.Material.Outlined.QueryStats" Style="font-size:3rem;" Class="text-muted mb-3" />
        <MudText Typo="Typo.h6" Class="mb-1">No backtest results available</MudText>
        <MudText Typo="Typo.body2" Class="text-muted mb-4">Run a backtest first before using Benchmark Comparison.</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/strategies/builder"
                   StartIcon="@Icons.Material.Filled.PlayArrow">Run a Backtest First</MudButton>
    </MudPaper>
}
else
{
<MudGrid>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="2">
            <StrategyVersionPicker PreselectedStrategyId="@StrategyId" PreselectedVersionId="@VersionId"
                                   OnSelectionChanged="OnVersionSelected" />

            <MudExpansionPanels Class="mt-3 mb-3">
                <MudExpansionPanel Text="Advanced / Manual Config" Expanded="false">
                    <ScenarioConfigEditor @ref="_configEditor" />
                </MudExpansionPanel>
            </MudExpansionPanels>

            <WorkflowRunner TResult="TradingResearchEngine.Application.Research.Results.BenchmarkComparisonResult"
                            ButtonText="Run Benchmark Comparison"
                            OnExecute="Execute">
                <ResultContent Context="result">
                    <MudGrid>
                        <MudItem xs="4"><MetricCard Label="Strategy Return" Value="@($"{result.StrategyReturn:P2}")" /></MudItem>
                        <MudItem xs="4"><MetricCard Label="Benchmark Return" Value="@($"{result.BenchmarkReturn:P2}")" /></MudItem>
                        <MudItem xs="4"><MetricCard Label="Alpha" Value="@($"{result.Alpha:P2}")" /></MudItem>
                        <MudItem xs="4"><MetricCard Label="Beta" Value="@(result.Beta?.ToString("F3") ?? "N/A")" /></MudItem>
                        <MudItem xs="4"><MetricCard Label="Info Ratio" Value="@(result.InformationRatio?.ToString("F3") ?? "N/A")" /></MudItem>
                        <MudItem xs="4"><MetricCard Label="Tracking Error" Value="@($"{result.TrackingError:F4}")" /></MudItem>
                    </MudGrid>
                </ResultContent>
            </WorkflowRunner>
        </MudPaper>
    </MudItem>
</MudGrid>
}

@code {
    [SupplyParameterFromQuery] public string? StrategyId { get; set; }
    [SupplyParameterFromQuery] public string? VersionId { get; set; }
    [SupplyParameterFromQuery(Name = "result")] public string? ResultId { get; set; }

    private ScenarioConfigEditor? _configEditor;
    private bool _hasResults = true;

    protected override async Task OnInitializedAsync()
    {
        var results = await BacktestResultRepo.ListAsync(CancellationToken.None);
        _hasResults = results.Any(r => r.Status == BacktestStatus.Completed);
    }

    private void OnVersionSelected((StrategyIdentity Strategy, StrategyVersion Version, BacktestResult? LatestRun) selection)
    {
        _configEditor?.LoadFromConfig(selection.Version.BaseScenarioConfig);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && ResultId is not null && _configEditor is not null)
        {
            var result = await ResultRepo.GetByIdAsync(ResultId);
            if (result is not null)
                _configEditor.LoadFromConfig(result.ScenarioConfig);
            else
                Snackbar.Add("Backtest result not found.", Severity.Warning);
            StateHasChanged();
        }
    }

    private async Task<TradingResearchEngine.Application.Research.Results.BenchmarkComparisonResult> Execute(CancellationToken ct)
    {
        var config = _configEditor!.BuildConfig();
        var options = new TradingResearchEngine.Application.Research.BenchmarkOptions
        {
            InitialCash = config.InitialCash
        };
        return await BenchWorkflow.RunAsync(config, options, ct);
    }
}
