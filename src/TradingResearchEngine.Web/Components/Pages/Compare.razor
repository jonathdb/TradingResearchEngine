@page "/compare"
@rendermode InteractiveServer
@inject TradingResearchEngine.Application.Research.ScenarioComparisonUseCase CompareUseCase
@inject TradingResearchEngine.Application.Export.ComparisonReportGenerator ReportGenerator
@inject TradingResearchEngine.Core.Persistence.IRepository<BacktestResult> ResultRepo
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Strategy Comparison — TradingResearchEngine</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Strategy Comparison</MudText>

<MudGrid>
    <MudItem xs="12">
        <MudPaper Class="pa-4" Elevation="2">
            <MultiResultPicker @ref="_picker" Label="Select results to compare" />

            <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary"
                       Class="mt-3" OnClick="RunComparison"
                       StartIcon="@Icons.Material.Filled.CompareArrows">
                Compare Selected
            </MudButton>
        </MudPaper>
    </MudItem>
</MudGrid>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
}

@if (_report is not null && _selectedResults is not null)
{
    <MudGrid Class="mt-4">
        <MudItem xs="12">
            <MudPaper Class="pa-4" Elevation="2">
                <div class="d-flex justify-space-between align-center mb-2">
                    <MudText Typo="Typo.h6">
                        Best by Sharpe: <MudChip T="string" Color="MudBlazor.Color.Success" Size="MudBlazor.Size.Small">@_report.BestBySharpe</MudChip>
                        Best by Drawdown: <MudChip T="string" Color="MudBlazor.Color.Info" Size="MudBlazor.Size.Small">@_report.BestByDrawdown</MudChip>
                    </MudText>
                    <MudButton Variant="Variant.Outlined" Color="MudBlazor.Color.Secondary"
                               StartIcon="@Icons.Material.Filled.FileDownload"
                               OnClick="ExportReport"
                               Disabled="_exporting"
                               aria-label="Export comparison report">
                        @if (_exporting)
                        {
                            <MudProgressCircular Size="MudBlazor.Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Export Report
                    </MudButton>
                </div>

                <MudTable Items="_report.Rows" Dense="true" Hover="true" Striped="true">
                    <HeaderContent>
                        <MudTh>Scenario</MudTh>
                        <MudTh>Sharpe</MudTh>
                        <MudTh>Sortino</MudTh>
                        <MudTh>Calmar</MudTh>
                        <MudTh>Max DD</MudTh>
                        <MudTh>Win Rate</MudTh>
                        <MudTh>PF</MudTh>
                        <MudTh>Expectancy</MudTh>
                        <MudTh>R²</MudTh>
                        <MudTh>Consec L</MudTh>
                        <MudTh>Trades</MudTh>
                        <MudTh>End Equity</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            @context.ScenarioId
                            @if (context.ScenarioId == _report.BestBySharpe) { <MudIcon Icon="@Icons.Material.Filled.Star" Color="MudBlazor.Color.Warning" Size="MudBlazor.Size.Small" /> }
                        </MudTd>
                        <MudTd>@(context.SharpeRatio?.ToString("F2") ?? "N/A")</MudTd>
                        <MudTd>@(context.SortinoRatio?.ToString("F2") ?? "N/A")</MudTd>
                        <MudTd>@(context.CalmarRatio?.ToString("F2") ?? "N/A")</MudTd>
                        <MudTd>@context.MaxDrawdown.ToString("P2")</MudTd>
                        <MudTd>@(context.WinRate?.ToString("P1") ?? "N/A")</MudTd>
                        <MudTd>@(context.ProfitFactor?.ToString("F2") ?? "N/A")</MudTd>
                        <MudTd>$@(context.Expectancy?.ToString("F2") ?? "N/A")</MudTd>
                        <MudTd>@(context.EquityCurveSmoothness?.ToString("F4") ?? "N/A")</MudTd>
                        <MudTd>@context.MaxConsecutiveLosses</MudTd>
                        <MudTd>@context.TotalTrades</MudTd>
                        <MudTd>$@context.EndEquity.ToString("F2")</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @* Charts *@
    <MudGrid Class="mt-4">
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-2">Overlaid Equity Curves</MudText>
                <OverlaidEquityCurves Results="_selectedResults" />
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-2">Metrics Radar</MudText>
                <MetricsRadarChart Results="_selectedResults" />
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    [SupplyParameterFromQuery(Name = "runIds")]
    public string? RunIdsParam { get; set; }

    private MultiResultPicker? _picker;
    private TradingResearchEngine.Core.Results.ComparisonReport? _report;
    private IReadOnlyList<BacktestResult>? _selectedResults;
    private string? _error;
    private bool _exporting;

    protected override async Task OnInitializedAsync()
    {
        // Support deep-linking with run IDs from Dashboard or other pages
        if (!string.IsNullOrWhiteSpace(RunIdsParam))
        {
            await LoadFromQueryString();
        }
    }

    private async Task LoadFromQueryString()
    {
        var ids = RunIdsParam!.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        if (ids.Length < 2)
        {
            _error = "At least 2 run IDs are required for comparison.";
            return;
        }

        if (ids.Length > 5)
        {
            _error = "Maximum 5 runs can be compared at once. Please select fewer runs.";
            return;
        }

        var results = new List<BacktestResult>();
        foreach (var id in ids)
        {
            var result = await ResultRepo.GetByIdAsync(id);
            if (result is not null)
                results.Add(result);
        }

        if (results.Count < 2)
        {
            _error = "Could not load enough valid runs for comparison.";
            return;
        }

        _selectedResults = results;
        _report = CompareUseCase.Compare(results);
    }

    private void RunComparison()
    {
        _error = null;
        _report = null;
        _selectedResults = null;

        var selected = _picker?.GetSelected();
        if (selected is null || selected.Count < 2)
        {
            _error = "Select at least 2 results to compare.";
            return;
        }

        try
        {
            _selectedResults = selected;
            _report = CompareUseCase.Compare(selected);
            Snackbar.Add($"Comparing {selected.Count} results", Severity.Success);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task ExportReport()
    {
        if (_selectedResults is null || _selectedResults.Count < 2)
            return;

        _exporting = true;
        try
        {
            var artifact = await ReportGenerator.GenerateAsync(_selectedResults);
            Snackbar.Add($"Report exported to {artifact.OutputPath}", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Export failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _exporting = false;
        }
    }
}
